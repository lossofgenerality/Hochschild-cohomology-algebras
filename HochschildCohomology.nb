(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["Hochschild Cohomology Algebras", "Title"],
Cell["Gerstenhaber structure and deformation theory, computed exactly with HochschildKit", "Subtitle"],
Cell[TextData[{Cell[BoxData[FormBox["\[Copyright]", TraditionalForm]]], " Computational Classnotes ", Cell[BoxData[FormBox["\[CenterDot]", TraditionalForm]]], " CC BY-NC-SA 4.0"}], "Text"],
Cell[BoxData[RowBox[{"DateString", "[", "]"}]], "Input", Evaluatable -> False, Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell[BoxData["\"Wed 18 Nov 2026 01:28:50\""], "Output", Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell["Keep this notebook in the same folder as HochschildKit.wl and HochschildDemo.wl, then choose Evaluation > Evaluate Notebook.", "Text"],
Cell["SetDirectory[NotebookDirectory[]];\nGet[\"HochschildKit.wl\"];", "Input"],
Cell["1. Conventions", "Section"],
Cell[TextData[{"A is a finite-dimensional algebra with structure constants ", Cell[BoxData[FormBox[SubsuperscriptBox["c", RowBox[{"i", "j"}], "k"], TraditionalForm]]], ":"}], "Text"],
Cell[BoxData[FormBox[RowBox[{SubscriptBox["e", "i"], SubscriptBox["e", "j"], "=", UnderscriptBox["\[Sum]", "k"], SubsuperscriptBox["c", RowBox[{"i", "j"}], "k"], SubscriptBox["e", "k"]}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"A p-cochain f is stored as an array with p+1 indices: f[[i1,...,ip,k]] is the coefficient of ", Cell[BoxData[FormBox[SubscriptBox["e", "k"], TraditionalForm]]], " in ", Cell[BoxData[FormBox[RowBox[{"f", "(", SubscriptBox["e", SubscriptBox["i", "1"]], ",", "\[Ellipsis]", ",", SubscriptBox["e", SubscriptBox["i", "p"]], ")"}], TraditionalForm]]], ". The structure constants are the multiplication ", Cell[BoxData[FormBox[RowBox[{"\[Mu]", "\[Element]", SuperscriptBox["C", "2"]}], TraditionalForm]]], "."}], "Text"],
Cell["A = TruncatedPolynomial[3];\nA[\"Basis\"]\nMu[A] // MatrixForm\nUnitCochain[A]", "Input"],
Cell["2. The Hochschild complex", "Section"],
Cell[BoxData[FormBox[RowBox[{RowBox[{"\[Delta]", "f"}], "(", SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", SubscriptBox["a", RowBox[{"p", "+", "1"}]], ")", "=", SubscriptBox["a", "1"], "f", "(", SubscriptBox["a", "2"], ",", "\[Ellipsis]", ")", "+", UnderoverscriptBox["\[Sum]", RowBox[{"i", "=", "1"}], "p"], SuperscriptBox[RowBox[{"(", "-1", ")"}], "i"], "f", "(", "\[Ellipsis]", ",", SubscriptBox["a", "i"], SubscriptBox["a", RowBox[{"i", "+", "1"}]], ",", "\[Ellipsis]", ")", "+", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"p", "+", "1"}]], "f", "(", SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", SubscriptBox["a", "p"], ")", SubscriptBox["a", RowBox[{"p", "+", "1"}]]}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"Check ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["\[Delta]", "2"], "=", "0"}], TraditionalForm]]], " and ", Cell[BoxData[FormBox[RowBox[{"\[Delta]", "f", "=", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"p", "-", "1"}]], "[", "\[Mu]", ",", "f", "]"}], TraditionalForm]]], "."}], "Text"],
Cell["f = RandomCochain[A, 2];\nAllTrue[Flatten@HDelta[A, HDelta[A, f]], # == 0 &]\nAllTrue[Flatten[HDelta[A, f] - (-1)^(2 - 1) GBracket[Mu[A], f]], # == 0 &]", "Input"],
Cell[TextData[{"Low degrees: ", Cell[BoxData[FormBox[SuperscriptBox["HH", "0"], TraditionalForm]]], " = centre, ", Cell[BoxData[FormBox[SuperscriptBox["HH", "1"], TraditionalForm]]], " = outer derivations, ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]], " = first-order deformations, ", Cell[BoxData[FormBox[SuperscriptBox["HH", "3"], TraditionalForm]]], " = obstructions."}], "Text"],
Cell["CochainForm[A, #] & /@ HHBasis[A, 1]\nCochainForm[A, #] & /@ HHBasis[A, 2]", "Input"],
Cell["3. Gerstenhaber composition and bracket", "Section"],
Cell[BoxData[FormBox[RowBox[{RowBox[{"f", "\[SmallCircle]", "g"}], "=", UnderscriptBox["\[Sum]", "i"], SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"(", "i", "-", "1", ")", "(", "q", "-", "1", ")"}]], "f", SubscriptBox["\[SmallCircle]", "i"], "g"}], TraditionalForm]], "DisplayFormula"],
Cell[BoxData[FormBox[RowBox[{"[", "f", ",", "g", "]", "=", "f", "\[SmallCircle]", "g", "-", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"(", "p", "-", "1", ")", "(", "q", "-", "1", ")"}]], "g", "\[SmallCircle]", "f"}], TraditionalForm]], "DisplayFormula"],
Cell["The pre-Lie identity for the composition gives the graded Jacobi identity for the bracket.", "Text"],
Cell["{f, g, h} = {RandomCochain[A, 2], RandomCochain[A, 1], RandomCochain[A, 2]};\n{p, q, r} = {2, 1, 2};\njac = (-1)^((p - 1) (r - 1)) GBracket[f, GBracket[g, h]] + (-1)^((q - 1) (p - 1)) GBracket[g, GBracket[h, f]] + (-1)^((r - 1) (q - 1)) GBracket[h, GBracket[f, g]];\nAllTrue[Flatten[jac], # == 0 &]", "Input"],
Cell["4. Cup product and the homotopy formula", "Section"],
Cell[BoxData[FormBox[RowBox[{"\[Delta]", "(", "f", "\[SmallCircle]", "g", ")", "=", "f", "\[SmallCircle]", "\[Delta]", "g", "+", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"q", "-", "1"}]], "\[Delta]", "f", "\[SmallCircle]", "g", "+", SuperscriptBox[RowBox[{"(", "-1", ")"}], "q"], "(", "g", "\[Union]", "f", "-", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"p", "q"}]], "f", "\[Union]", "g", ")"}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"On cocycles this makes ", Cell[BoxData[FormBox["\[Union]", TraditionalForm]]], " graded commutative on HH."}], "Text"],
Cell["{f, g} = {RandomCochain[A, 2], RandomCochain[A, 1]}; {p, q} = {2, 1};\nlhs = HDelta[A, GCircle[f, g]];\nrhs = GCircle[f, HDelta[A, g]] + (-1)^(q - 1) GCircle[HDelta[A, f], g] + (-1)^q (Cup[A, g, f] - (-1)^(p q) Cup[A, f, g]);\nAllTrue[Flatten[lhs - rhs], # == 0 &]", "Input"],
Cell[TextData[{"5. ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "*"], "(", "A", ",", "A", ")"}], TraditionalForm]]], " as a Gerstenhaber algebra"}], "Section"],
Cell["IdentityReport runs every cochain-level and cohomology-level identity, including both forms of the Poisson rule.", "Text"],
Cell["IdentityReport[TruncatedPolynomial[3]] // Dataset", "Input"],
Cell["D1 = DualNumbers[];\nTable[CochainForm[D1, #] & /@ HHBasis[D1, p], {p, 0, 4}]\nHHCupTable[D1, 1, 2]\nHHBracketTable[D1, 1, 2]", "Input"],
Cell["6. Deformation theory", "Section"],
Cell[TextData[{"Maurer-Cartan equation, order by order:"}], "Text"],
Cell[BoxData[FormBox[RowBox[{"\[Delta]", SubscriptBox["\[Mu]", "n"], "=", UnderscriptBox["\[Sum]", RowBox[{"i", "+", "j", "=", "n"}]], SubscriptBox["\[Mu]", "i"], "\[SmallCircle]", SubscriptBox["\[Mu]", "j"]}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"DeformAlgebra solves it order by order and stops at a nonzero obstruction class in ", Cell[BoxData[FormBox[SuperscriptBox["HH", "3"], TraditionalForm]]], "."}], "Text"],
Cell["Q1 = QuantumPlane[1];\nH2 = HHBasis[Q1, 2];\nCochainForm[Q1, #] & /@ H2\nObstructionMap[Q1]", "Input"],
Cell["d = DeformAlgebra[Q1, H2[[4]], 5];\nd[\"Status\"]\nAssociativeQ[DeformedStructureConstants[Q1, d[\"Terms\"], t]]\nDeformAlgebra[Q1, H2[[1]] + H2[[4]], 4][\"Status\"]", "Input"],
Cell["7. Hochschild cohomology tables", "Section"],
Cell["Grid[Prepend[{#1, Sequence @@ #2} & @@@ {\n   {\"k[x]/(x^2)\", HHDimensions[DualNumbers[], 5]},\n   {\"k[x]/(x^2), char 2\", HHDimensions[DualNumbers[], 5, Modulus -> 2]},\n   {\"k[x]/(x^3)\", HHDimensions[TruncatedPolynomial[3], 4]},\n   {\"M_2(k)\", HHDimensions[MatrixAlgebra[2], 3]},\n   {\"T_2(k)\", HHDimensions[UpperTriangular[2], 4]},\n   {\"k[x,y]/(x^2,y^2)\", HHDimensions[QuantumPlane[1], 3]},\n   {\"Lambda(k^2)\", HHDimensions[QuantumPlane[-1], 3]},\n   {\"quantum plane q=2\", HHDimensions[QuantumPlane[2], 3]}},\n  {\"Algebra\", \"HH0\", \"HH1\", \"HH2\", \"HH3\", \"HH4\", \"HH5\"}], Frame -> All, Alignment -> Left]", "Input"],
Cell["8. Full demo", "Section"],
Cell["Get[\"HochschildDemo.wl\"]", "Input"],
Cell[TextData[{Cell[BoxData[FormBox["\[Copyright]", TraditionalForm]]], " Computational Classnotes ", Cell[BoxData[FormBox["\[CenterDot]", TraditionalForm]]], " CC BY-NC-SA 4.0"}], "Text"]
}, WindowSize -> {1000, 800}, StyleDefinitions -> "Default.nb"]
