Cell[TextData[{
 "For the functions on a smooth space this dictionary is a theorem \
(Hochschild-Kostant-Rosenberg): ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "1"], TraditionalForm]],ExpressionUUID->
  "6c93c704-56e2-4676-a355-a3e7326d706c"],
 " is exactly the vector fields and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "2"], TraditionalForm]],ExpressionUUID->
  "5dcf963b-3b19-4c80-8010-6a11b3d734b9"],
 " the bivector fields. For a finite-dimensional algebra it is the guiding \
picture, and section 7 shows each line of the table in action."
}], "Text",ExpressionUUID->"d9d77d2f-0e46-4108-bec4-698ecda7c37a"],

Cell["1. The two operators", "Section",ExpressionUUID->"13da029e-7dd4-4e75-aee7-46995bf1fe49"],

Cell[TextData[{
 "An element of an algebra A is stored by its coefficients in the basis of A, \
and a Hochschild cochain by its array of values. ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"a", "\[CircleTimes]", "b"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "d291968a-404c-4cee-acb4-cdc03016804d"],
 " is the product of A on elements and the cup product on cochains; ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"a", "\[CirclePlus]", "b"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "56dc2649-41e2-4b16-9ba2-bf3533de3052"],
 " is the sum. A cochain is applied to elements as in the books, f[a, b], and \
\[Delta] is the Hochschild differential."
}], "Text",ExpressionUUID->"2d8b6616-b7d9-4721-a329-35dca74137a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Elt", ",", " ", "Coch", ",", " ", "\[Delta]", ",", " ", "Generators"}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zeroQ", "[", "w_", "]"}], " ", ":=", " ", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"Simplify", "[", "w", "]"}], "}"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"#", " ", "===", " ", "0"}], " ", "&"}]}], "]"}]}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"algebra", " ", 
    RowBox[{"elements", ":", " ", 
     RowBox[{"Elt", "[", 
      RowBox[{"A", ",", " ", 
       RowBox[{
       "coefficients", " ", "in", " ", "the", " ", "basis", " ", "of", " ", 
        "A"}]}], "]"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Generators", "[", "A_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Elt", "[", 
      RowBox[{"A", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"IdentityMatrix", "[", 
     RowBox[{"AlgebraDimension", "[", "A", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "u_"}], "]"}], ",", " ", 
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "v_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Elt", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"Expand", "[", 
      RowBox[{"v", " ", ".", " ", 
       RowBox[{"(", 
        RowBox[{"u", " ", ".", " ", 
         RowBox[{"Mu", "[", "A", "]"}]}], ")"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{"a_Elt", ",", " ", "b_Elt", ",", " ", "c__Elt"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{
     RowBox[{"CircleTimes", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "c"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "u_"}], "]"}], ",", " ", 
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "v_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Elt", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"u", " ", "+", " ", "v"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{"a_Elt", ",", " ", "b_Elt", ",", " ", "c__Elt"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{
     RowBox[{"CirclePlus", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "c"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{
    RowBox[{"Times", "[", 
     RowBox[{"c_", ",", " ", 
      RowBox[{"Elt", "[", 
       RowBox[{"A_", ",", " ", "u_"}], "]"}]}], "]"}], " ", "/;", " ", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"c", ",", " ", 
      RowBox[{"Elt", " ", "|", " ", "Coch"}]}], "]"}]}], " ", ":=", " ", 
   RowBox[{"Elt", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"c", " ", "u"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"Equal", "[", 
    RowBox[{
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "u_"}], "]"}], ",", " ", 
     RowBox[{"Elt", "[", 
      RowBox[{"A_", ",", " ", "v_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"zeroQ", "[", 
    RowBox[{"u", " ", "-", " ", "v"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Elt", " ", "/:", " ", 
   RowBox[{"Equal", "[", 
    RowBox[{
     RowBox[{"Elt", "[", 
      RowBox[{"_", ",", " ", "u_"}], "]"}], ",", " ", "0"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"zeroQ", "[", "u", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Elt", " ", "/:", " ", 
    RowBox[{"MakeBoxes", "[", 
     RowBox[{
      RowBox[{"Elt", "[", 
       RowBox[{"A_", ",", " ", "u_"}], "]"}], ",", " ", "fmt_"}], "]"}], " ", 
    ":=", " ", 
    RowBox[{"ToBoxes", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", " ", "=", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#2", " ", "==", " ", "\"\<1\>\""}], ",", " ", "#1", ",",
                 " ", 
                RowBox[{"#1", " ", 
                 RowBox[{"Style", "[", 
                  RowBox[{"#2", ",", " ", "Italic", ",", " ", 
                   RowBox[{
                   "ShowStringCharacters", " ", "->", " ", "False"}]}], 
                  "]"}]}]}], "]"}], " ", "&"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Simplify", "[", "u", "]"}], ",", " ", 
               RowBox[{"A", "[", "\"\<Basis\>\"", "]"}]}], "}"}]}], "]"}], 
           "]"}]}], "}"}], ",", " ", "t"}], "]"}], ",", " ", "fmt"}], "]"}]}],
    ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Hochschild", " ", 
      RowBox[{"cochains", ":", " ", 
       RowBox[{"Coch", "[", 
        RowBox[{"A", ",", " ", 
         RowBox[{"array", " ", "of", " ", "values"}]}], "]"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}], " ", "evaluates"}]}], ",", " ", 
    RowBox[{
     RowBox[{"f", " ", "\[CircleTimes]", " ", "g"}], " ", "is", " ", "the", " ",
      "cup", " ", "product"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "f_"}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "g_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"f", " ", "+", " ", "g"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "f_"}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "g_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"Cup", "[", 
      RowBox[{"A", ",", " ", "f", ",", " ", "g"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{"a_Coch", ",", " ", "b_Coch", ",", " ", "c__Coch"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"CirclePlus", "[", 
    RowBox[{
     RowBox[{"CirclePlus", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "c"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{"a_Coch", ",", " ", "b_Coch", ",", " ", "c__Coch"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"CircleTimes", "[", 
    RowBox[{
     RowBox[{"CircleTimes", "[", 
      RowBox[{"a", ",", " ", "b"}], "]"}], ",", " ", "c"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{
    RowBox[{"Times", "[", 
     RowBox[{"c_", ",", " ", 
      RowBox[{"Coch", "[", 
       RowBox[{"A_", ",", " ", "f_"}], "]"}]}], "]"}], " ", "/;", " ", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"c", ",", " ", 
      RowBox[{"Elt", " ", "|", " ", "Coch"}]}], "]"}]}], " ", ":=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"c", " ", "f"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"Equal", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "f_"}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "g_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"zeroQ", "[", 
    RowBox[{"f", " ", "-", " ", "g"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"Equal", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"_", ",", " ", "f_"}], "]"}], ",", " ", "0"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"zeroQ", "[", "f", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Coch", "[", 
     RowBox[{"A_", ",", " ", "f_"}], "]"}], "[", "a___Elt", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Elt", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"EvaluateCochain", "[", 
      RowBox[{"f", ",", " ", 
       RowBox[{
        RowBox[{"{", "a", "}"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", 
    RowBox[{"Coch", "[", 
     RowBox[{"A_", ",", " ", "f_"}], "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"HDelta", "[", 
      RowBox[{"A", ",", " ", "f"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "f_"}], "]"}], ",", " ", "fmt_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"ToBoxes", "[", 
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<cochain in \>\"", ",", " ", 
        RowBox[{"Superscript", "[", 
         RowBox[{"\"\<C\>\"", ",", " ", 
          RowBox[{"CochainDegree", "[", "f", "]"}]}], "]"}]}], "}"}], "]"}], ",",
      " ", "fmt"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"a22476a8-92b9-\
48c4-bd01-8cdf44517251"],

Cell["How the books write it", "Subsection",ExpressionUUID->"8be0d753-9996-4526-b3e4-0381c582c174"],

Cell["\<\
A Coch object is a Hochschild cochain. In the books the space of n-cochains \
of A with values in a bimodule M is\
\>", "Text",ExpressionUUID->"899f251b-2c5d-4ba5-bf35-f92534f84a2a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["C", "n"], "(", "A", ",", "M", ")"}], "=", 
   RowBox[{
    SubscriptBox["Hom", "k"], "(", 
    SuperscriptBox["A", 
     RowBox[{"\[CircleTimes]", "n"}]], ",", "M", ")"}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"7a30f245-4fa3-4e25-\
b557-b28fc85ed58f"],

Cell[TextData[{
 "the k-linear maps of n arguments ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["a", "n"], ")"}], TraditionalForm]],ExpressionUUID->
  "16ca1df6-0776-4d83-89ba-286084fc50cd"],
 " from A to M. Here M = A, so a Coch is an element of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["C", "n"], "(", "A", ",", "A", ")"}], TraditionalForm]],
  ExpressionUUID->"2aded89d-f68b-43e1-9f8f-2450b6d1092f"],
 ". The dictionary:"
}], "Text",ExpressionUUID->"a03d417c-7876-4ca0-b074-55f339a133af"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"In this notebook\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"In the books\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"Coch[A, f]  (p arguments)\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"60b6e6c3-5583-41f4-bbfd-d6e0ee238e74"],
      TextCell[
       Style[
       "Coch[A, f]  (p arguments)", FontFamily -> "Source Code Pro", FontSize -> 
        12]]], 
     FormBox[
      RowBox[{"f", "\[Element]", 
       RowBox[{
        SuperscriptBox["C", "p"], "(", "A", ",", "A", ")"}], "=", 
       RowBox[{
        SubscriptBox["Hom", "k"], "(", 
        SuperscriptBox["A", 
         RowBox[{"\[CircleTimes]", "p"}]], ",", "A", ")"}]}],
      TraditionalForm]},
    {
     InterpretationBox[Cell[
      "all the cochains together",ExpressionUUID->
       "50fe82da-fa1f-4823-97eb-2aa93cb3cd53"],
      TextCell["all the cochains together"]], 
     TemplateBox[{
       InterpretationBox[
        Cell["the Hochschild complex "], 
        TextCell["the Hochschild complex "]], 
       FormBox[
        RowBox[{"(", 
          RowBox[{
            SuperscriptBox["C", "\[Bullet]"], "(", "A", ",", "A", ")"}], ",", 
          "\[Delta]", ")"}], TraditionalForm]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"Coch[A, u]  (no arguments)\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"ef2b1ea9-0715-4c81-9d65-e720745225f4"],
      TextCell[
       Style[
       "Coch[A, u]  (no arguments)", FontFamily -> "Source Code Pro", 
        FontSize -> 12]]], 
     FormBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["C", "0"], "(", "A", ",", "A", ")"}], "=", "A"}],
      TraditionalForm]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"\[Delta][f]\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"153333cc-fb27-4ea3-82eb-f82fa2b03228"],
      TextCell[
       Style[
       "\[Delta][f]", FontFamily -> "Source Code Pro", FontSize -> 12]]], 
     TemplateBox[{
       FormBox[
        RowBox[{
          RowBox[{"\[Delta]", "f"}], "\[Element]", 
          RowBox[{
            SuperscriptBox["C", 
             RowBox[{"p", "+", "1"}]], "(", "A", ",", "A", ")"}]}], 
        TraditionalForm], 
       InterpretationBox[
        Cell[", also written d or b"], 
        TextCell[", also written d or b"]]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"CocycleQ[A, f]\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"687c605b-f9d8-4d89-8556-1e3cbde67dbc"],
      TextCell[
       Style[
       "CocycleQ[A, f]", FontFamily -> "Source Code Pro", FontSize -> 12]]], 
     TemplateBox[{
       FormBox[
        RowBox[{"f", "\[Element]", 
          RowBox[{
            SuperscriptBox["Z", "p"], "(", "A", ",", "A", ")"}], "=", 
          RowBox[{"ker", " ", "\[Delta]"}]}], TraditionalForm], 
       InterpretationBox[
        Cell[", a cocycle"], 
        TextCell[", a cocycle"]]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"CoboundaryQ[A, f]\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"b0e3dfb7-bacf-4219-87eb-7246f35baa63"],
      TextCell[
       Style[
       "CoboundaryQ[A, f]", FontFamily -> "Source Code Pro", FontSize -> 
        12]]], 
     TemplateBox[{
       FormBox[
        RowBox[{"f", "\[Element]", 
          RowBox[{
            SuperscriptBox["B", "p"], "(", "A", ",", "A", ")"}], "=", 
          RowBox[{"im", " ", "\[Delta]"}]}], TraditionalForm], 
       InterpretationBox[
        Cell[", a coboundary"], 
        TextCell[", a coboundary"]]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"a class from HHBasis\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"ca7844f7-6447-4489-bc22-7c2fc09a7588"],
      TextCell[
       Style[
       "a class from HHBasis", FontFamily -> "Source Code Pro", FontSize -> 
        12]]], 
     FormBox[
      RowBox[{
       RowBox[{"[", "f", "]"}], "\[Element]", 
       RowBox[{
        SuperscriptBox["HH", "p"], "(", "A", ",", "A", ")"}], "=", 
       RowBox[{
        SuperscriptBox["Z", "p"], "/", 
        SuperscriptBox["B", "p"]}]}],
      TraditionalForm]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"deg[f]\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
