Cell["0. Intuition: what is a cochain?", "Section",ExpressionUUID->"673f9eac-0824-42df-bbbb-fc4e3447b521"],

Cell["Cochains in geometry", "Subsection",ExpressionUUID->"c657e7c2-1410-4592-9618-519bd311bd3f"],

Cell["\<\
Draw a shape out of points, edges and triangles. A 0-cochain puts a number on \
every point, like a temperature. A 1-cochain puts a number on every edge, \
like the work done walking along it. A 2-cochain puts a number on every \
triangle, like the flux through it.\
\>", "Text",ExpressionUUID->"1e55f246-5ee8-4026-bfbc-4cfa20b4fbd5"],

Cell["\<\
In two dimensions: a square cut into two triangles. Red numbers sit on the \
points (a 0-cochain f), blue numbers on the oriented edges, green numbers \
inside the triangles. The middle panel shows the coboundary of f: each edge \
carries the change of f along it, and around every triangle these changes add \
up to 0. The right panel shows a 1-cochain \[Omega] that is not a gradient; \
its coboundary is the circulation around each triangle, a 2-cochain.\
\>", "Text",ExpressionUUID->"420a901d-66bc-4494-b5ad-c81a41c89951"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", "square", " ", "cut", " ", "into", " ", "two", " ", 
     RowBox[{"triangles", ":", " ", 
      RowBox[{"4", " ", "points"}]}]}], ",", " ", 
    RowBox[{"5", " ", "oriented", " ", "edges"}], ",", " ", 
    RowBox[{"2", " ", "triangles"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"pts", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"edg", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3"}], "}"}]}], "}"}]}], ";"}], 
   "             ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "each", " ", "edge", " ", "points", " ", "from", " ", "its", " ", "first",
      " ", "vertex", " ", "to", " ", "its", " ", "second"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tri", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "3", ",", " ", "4"}], "}"}]}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"fv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "7", ",", " ", "2", ",", " ", "4"}], "}"}]}], 
    ";"}], "                                          ", 
   RowBox[{"(*", " ", 
    RowBox[{"0", "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{"a", " ", "number", " ", "on", " ", "each", " ", "point"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"dfv", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"fv", "[", 
         RowBox[{"[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{"fv", "[", 
         RowBox[{"[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], " ", "&"}], " ", "/@",
       " ", "edg"}]}], ";"}], "                 ", 
   RowBox[{"(*", " ", 
    RowBox[{"its", " ", 
     RowBox[{"coboundary", ":", " ", 
      RowBox[{
      "the", " ", "change", " ", "of", " ", "fv", " ", "along", " ", "each", " ",
        "edge"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"wv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "0"}], "}"}]}], ";"}], 
   "                                      ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"a", " ", "1"}], "-", 
     RowBox[{
     "cochain", " ", "that", " ", "is", " ", "not", " ", "a", " ", 
      "gradient"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"onEdge", "[", 
      RowBox[{"c_", ",", " ", 
       RowBox[{"{", 
        RowBox[{"i_", ",", " ", "j_"}], "}"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"c", "[", 
      RowBox[{"[", 
       RowBox[{"First", "@", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"edg", ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "j"}], "}"}]}], "]"}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dTri", "[", "c_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"onEdge", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], " ", "+", " ", 
        
        RowBox[{"onEdge", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}], " ", "-", " ", 
        
        RowBox[{"onEdge", "[", 
         RowBox[{"c", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], " ", "&"}], 
      " ", "/@", " ", "tri"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"circulation", " ", "around", " ", "each", " ", "triangle"}], " ",
     "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"shrink", "[", 
      RowBox[{"{", 
