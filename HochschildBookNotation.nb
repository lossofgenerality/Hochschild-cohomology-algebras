        RowBox[{"f3", "[", 
         RowBox[{"[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], " ", "&"}], " ", "/@",
       " ", "te"}]}], ";"}], "                   ", 
   RowBox[{"(*", " ", 
    RowBox[{"1", "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{
      "the", " ", "change", " ", "of", " ", "temperature", " ", "along", " ", 
       "each", " ", "edge"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"g3", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"-", "1"}], ",", " ", "3", ",", " ", "1"}], "}"}]}], ";"}], 
   "                                         ", 
   RowBox[{"(*", " ", 
    RowBox[{"2", "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{
      "a", " ", "flux", " ", "through", " ", "each", " ", "face"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"ctr", " ", "=", " ", 
     RowBox[{"Mean", "[", "tv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"out", "[", 
      RowBox[{"p_", ",", " ", "s_"}], "]"}], " ", ":=", " ", 
     RowBox[{"p", " ", "+", " ", 
      RowBox[{"s", " ", 
       RowBox[{"(", 
        RowBox[{"p", " ", "-", " ", "ctr"}], ")"}]}]}]}], ";"}], 
