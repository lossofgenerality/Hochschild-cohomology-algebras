         " ", "edg"}], ",", "\n", "   ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
             "#1", ",", " ", "15", ",", " ", "Bold", ",", " ", "col", ",", 
              " ", 
              RowBox[{"Background", " ", "->", " ", "White"}]}], "]"}], ",", 
            " ", 
            RowBox[{"Mean", "[", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "#2", "]"}], "]"}], "]"}]}], "]"}], " ", "&"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"vals", ",", " ", "edg"}], "}"}]}], "]"}]}], "}"}]}], ";"}],
    "\n", 
   RowBox[{
