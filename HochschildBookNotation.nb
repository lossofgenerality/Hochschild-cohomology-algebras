                    RowBox[{"tv", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "-", 
                    " ", 
                    RowBox[{"tv", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ")"}]}]}],
                 ",", " ", 
                RowBox[{
                 RowBox[{"tv", "[", 
