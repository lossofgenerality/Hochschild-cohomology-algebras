Cell["Variants you will meet in other books:", "Text",ExpressionUUID->"25796fb2-c1d0-4087-99bf-e7d1bcbb5ad2"],

Cell[TextData[{
 "Bar resolution: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["C", "n"], "(", "A", ",", "M", ")"}], "\[TildeFullEqual]", 
    RowBox[{
     SubscriptBox["Hom", 
      SuperscriptBox["A", "e"]], "(", 
     SuperscriptBox["A", 
      RowBox[{"\[CircleTimes]", 
       RowBox[{"(", 
        RowBox[{"n", "+", "2"}], ")"}]}]], ",", "M", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"f0e2476d-bfd6-49d3-9526-0785e3eae5f7"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "e"], "=", 
    RowBox[{"A", "\[CircleTimes]", 
     SuperscriptBox["A", "op"]}]}], TraditionalForm]],ExpressionUUID->
  "15b26e54-1bb8-4556-8969-0afe47b5f92d"],
 ", which is how ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["HH", "n"], "(", "A", ",", "M", ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["Ext", 
      SuperscriptBox["A", "e"], "n"], "(", "A", ",", "M", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"39b74bc2-9bf4-4df4-8227-1dcf4c5d972a"],
 " is usually defined."
}], "Item",ExpressionUUID->"237fd684-a695-4492-a347-499a8226c795"],

Cell[TextData[{
 "Normalized cochains ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    OverscriptBox["C", "_"], "n"], TraditionalForm]],ExpressionUUID->
  "779d8154-602c-479b-8689-1641e8d3a3ed"],
 ": the cochains that vanish when any argument is 1. They have the same \
cohomology."
}], "Item",ExpressionUUID->"511c35ae-903b-4bce-9758-9a3ff876afed"],

Cell[TextData[{
 "Shifted grading for the bracket: Gerstenhaber puts a p-cochain in degree p \
- 1, so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["C", 
     RowBox[{"\[Bullet]", "+", "1"}]], "(", "A", ",", "A", ")"}], 
   TraditionalForm]],ExpressionUUID->"151ccbc3-0fdb-49a9-9c15-77d9321f8e2c"],
 " becomes a graded Lie algebra."
}], "Item",ExpressionUUID->"b903379f-c160-41a9-8b8f-ccb7b3c3be39"],

Cell[TextData[{
 "This notebook writes the cup product as ",
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]],ExpressionUUID->
  "37ef68e0-3b65-452a-b708-3a7cf9dd9d91"],
 " so that one operator covers all multiplication. The books write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "\[Cup]", "g"}], TraditionalForm]],ExpressionUUID->
  "930ebc1c-7b52-4d8e-be67-5e133f984948"],
 "."
}], "Text",ExpressionUUID->"a93d2523-1e10-488b-b754-d7a32dc08541"],

Cell["2. Expanding, distributing and simplifying", "Section",ExpressionUUID->"dc697ddd-dd9e-4e79-8b36-e2ce14c9a783"],

Cell[TextData[{
 "BookExpand applies the ring axioms symbolically: it distributes ",
 Cell[BoxData["\[CircleTimes]"],ExpressionUUID->
  "5461db67-4e90-442a-8273-a651ca83b68d"],
 " over ",
 Cell[BoxData["\[CirclePlus]"],ExpressionUUID->
  "04257471-96c5-417d-a022-447d1f56769f"],
 ", flattens nested products and sums, pulls scalars out, collects like terms \
and simplifies their coefficients. Declare which symbols are algebra \
elements; every other symbol is a scalar."
}], "Text",ExpressionUUID->"f6b9b717-bad5-429f-804f-6e3dffc49df3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$Elements", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DeclareElements", "[", "s__Symbol", "]"}], " ", ":=", " ", 
   RowBox[{"(", 
    RowBox[{"$Elements", " ", "=", " ", 
     RowBox[{"Union", "[", 
      RowBox[{"$Elements", ",", " ", 
       RowBox[{"{", "s", "}"}]}], "]"}]}], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"scalarQ", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"FreeQ", "[", 
     RowBox[{"s", ",", " ", 
      RowBox[{
      "CircleTimes", " ", "|", " ", "CirclePlus", " ", "|", " ", "_Elt", " ", 
       "|", " ", "_Coch"}]}], "]"}], " ", "&&", " ", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"s", ",", " ", 
      RowBox[{"Alternatives", " ", "@@", " ", "$Elements"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"bookRules", " ", "=", " ", 
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"CirclePlus", "[", 
       RowBox[{"p___", ",", " ", 
        RowBox[{"CirclePlus", "[", "r__", "]"}], ",", " ", "s___"}], "]"}], 
      " ", ":>", " ", 
      RowBox[{"CirclePlus", "[", 
       RowBox[{"p", ",", " ", "r", ",", " ", "s"}], "]"}]}], ",", "\n", "  ", 
     
     RowBox[{
      RowBox[{"CircleTimes", "[", 
       RowBox[{"p___", ",", " ", 
        RowBox[{"CircleTimes", "[", "r__", "]"}], ",", " ", "s___"}], "]"}], 
      " ", ":>", " ", 
      RowBox[{"CircleTimes", "[", 
       RowBox[{"p", ",", " ", "r", ",", " ", "s"}], "]"}]}], ",", "\n", "  ", 
     
     RowBox[{
      RowBox[{"CircleTimes", "[", 
       RowBox[{"p___", ",", " ", 
        RowBox[{"CirclePlus", "[", "r__", "]"}], ",", " ", "s___"}], "]"}], 
      " ", ":>", " ", 
      RowBox[{"(", 
       RowBox[{"CirclePlus", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"CircleTimes", "[", 
            RowBox[{"p", ",", " ", "#", ",", " ", "s"}], "]"}], " ", "&"}], 
          " ", "/@", " ", 
          RowBox[{"{", "r", "}"}]}], ")"}]}], ")"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"CircleTimes", "[", 
       RowBox[{"p___", ",", " ", 
        RowBox[{"Times", "[", 
         RowBox[{
          RowBox[{"c_", "?", "scalarQ"}], ",", " ", "e_"}], "]"}], ",", " ", 
        "s___"}], "]"}], " ", ":>", " ", 
      RowBox[{"c", " ", 
       RowBox[{"CircleTimes", "[", 
        RowBox[{"p", ",", " ", "e", ",", " ", "s"}], "]"}]}]}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"Times", "[", 
       RowBox[{
        RowBox[{"c_", "?", "scalarQ"}], ",", " ", 
        RowBox[{"CirclePlus", "[", "r__", "]"}]}], "]"}], " ", ":>", " ", 
      RowBox[{"(", 
       RowBox[{"CirclePlus", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"c", " ", "#"}], " ", "&"}], " ", "/@", " ", 
          RowBox[{"{", "r", "}"}]}], ")"}]}], ")"}]}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"CirclePlus", "[", "e_", "]"}], " ", ":>", " ", "e"}], ",", " ", 
     RowBox[{
      RowBox[{"CircleTimes", "[", "e_", "]"}], " ", ":>", " ", "e"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"splitTerm", "[", "t_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"fs", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "t", "]"}], " ", "===", " ", "Times"}], ",", 
         " ", 
         RowBox[{"List", " ", "@@", " ", "t"}], ",", " ", 
         RowBox[{"{", "t", "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Times", " ", "@@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"fs", ",", " ", "scalarQ"}], "]"}]}], ",", " ", 
       RowBox[{"Times", " ", "@@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"fs", ",", " ", 
          RowBox[{
           RowBox[{"!", " ", 
            RowBox[{"scalarQ", "[", "#", "]"}]}], " ", "&"}]}], "]"}]}]}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"collectTerms", "[", "e_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ts", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "e", "]"}], " ", "===", " ", "CirclePlus"}], ",",
           " ", 
          RowBox[{"List", " ", "@@", " ", "e"}], ",", " ", 
          RowBox[{"{", "e", "}"}]}], "]"}]}], ",", " ", "g"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"g", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Normal", "@", 
          RowBox[{"GroupBy", "[", 
           RowBox[{
            RowBox[{"splitTerm", " ", "/@", " ", "ts"}], ",", " ", 
            RowBox[{"Last", " ", "->", " ", "First"}], ",", " ", 
            RowBox[{"Simplify", "@*", "Total"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "=!=", " ", "0"}], " ", 
          "&"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"g", " ", "===", " ", 
         RowBox[{"{", "}"}]}], ",", " ", "0", ",", " ", 
        RowBox[{
         RowBox[{"Length", "[", "g", "]"}], " ", "==", " ", "1"}], ",", " ", 
        RowBox[{
         RowBox[{"g", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
         RowBox[{"g", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", "True", ",",
         " ", 
        RowBox[{"CirclePlus", " ", "@@", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"SortBy", "[", 
            RowBox[{"g", ",", " ", "First"}], "]"}]}], ")"}]}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BookExpand", "[", "e_", "]"}], " ", ":=", " ", 
   RowBox[{"collectTerms", "[", 
    RowBox[{"FixedPoint", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ReplaceRepeated", "[", 
        RowBox[{"#", ",", " ", "bookRules"}], "]"}], " ", "&"}], ",", " ", 
      "e"}], "]"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"acaa9f81-3db5-\
4ed1-897f-d1cf1634a1a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DeclareElements", "[", 
   RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], ";"}], "\n", 
 RowBox[{"BookExpand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], ")"}], " ", "\[CircleTimes]",
    " ", 
   RowBox[{"(", 
    RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], ")"}]}], "]"}]}], "Input",E\
xpressionUUID->"ab396f60-3160-48c6-9629-f3f1f9da4663"],

Cell[BoxData[
 RowBox[{"BookExpand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "a"}], " ", "\[CirclePlus]", " ", 
     RowBox[{"-", "b"}]}], ")"}], " ", "\[CircleTimes]", " ", 
   RowBox[{"(", 
