Notebook[{
Cell["Hochschild Algebra in Book Notation", "Title",ExpressionUUID->"4d0b799c-ca7d-4e7f-88b5-681714b91ee3"],

Cell[TextData[{
 "The infix operators ",
 Cell[BoxData["\[CircleTimes]"],ExpressionUUID->
  "46b2b93e-bd0c-4e11-96c3-5eb39bc55319"],
 " and ",
 Cell[BoxData["\[CirclePlus]"],ExpressionUUID->
  "1e84089b-eb03-4a29-9940-1a5645820a51"]
}], "Subtitle",ExpressionUUID->"96056b27-a287-4306-977f-d61200efa4ae"],

