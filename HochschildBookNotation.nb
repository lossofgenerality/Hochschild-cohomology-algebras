Cell["3. Elements of an algebra", "Section",ExpressionUUID->"abc3e467-0a23-464c-9b2f-e9ba9d280db3"],

Cell[TextData[{
 "Dual numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "481211f5-2c23-40de-be9b-ba4249a6967d"],
 ": ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"x", "\[CircleTimes]", "x"}], "\[LongEqual]", "0"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "5cc57ed9-3006-4b3d-9674-013484839680"],
 " and ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "\[CirclePlus]", "x"}], ")"}], "\[CircleTimes]", 
       RowBox[{"(", 
        RowBox[{"1", "\[CirclePlus]", 
         RowBox[{"-", "x"}]}], ")"}]}], "\[LongEqual]", "1"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "7f8aa1e5-6c36-4a84-8579-c043cd4dc05d"],
 "."
}], "Text",ExpressionUUID->"669ff063-1232-46fc-9b58-87cec7b27a9d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"DualNumbers", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x"}], "}"}], " ", "=", " ", 
   RowBox[{"Generators", "[", "A", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x", " ", "\[CircleTimes]", " ", "x"}], " ", "==", " ", 
  "0"}]}], "Input",ExpressionUUID->"f2bfbef5-6b27-4b41-8060-cbf849e16b59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"one", " ", "\[CirclePlus]", " ", "x"}], ")"}], " ", "\[CircleTimes]",
   " ", 
  RowBox[{"(", 
   RowBox[{"one", " ", "\[CirclePlus]", " ", 
    RowBox[{"-", "x"}]}], ")"}], "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "x"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "x"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"x", "^", "2"}]}], " ", "=", " ", "1"}]}], " ", 
   "*)"}]}]], "Input",ExpressionUUID->"4537deef-729c-4d4b-a014-1c5152ad9b80"],

Cell[TextData[{
 "The quantum plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   "k", "\[LeftAngleBracket]", "x", ",", "y", "\[RightAngleBracket]", "/", "(", 
    SuperscriptBox["x", "2"], ",", 
    SuperscriptBox["y", "2"], ",", 
    RowBox[{"y", "x", "-", "q", "x", "y"}], ")"}], TraditionalForm]],
  ExpressionUUID->"15395d58-d318-4588-855d-2ab2bc32dd65"],
 " with a symbolic parameter q:"
}], "Text",ExpressionUUID->"edc3c890-ed0f-4bec-a024-55d1df0cdbcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"QuantumPlane", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x", ",", " ", "y", ",", " ", "xy"}], "}"}], " ",
    "=", " ", 
   RowBox[{"Generators", "[", "A", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y", " ", "\[CircleTimes]", " ", "x"}], " ", "==", " ", 
  RowBox[{"q", " ", 
   RowBox[{"(", 
    RowBox[{"x", " ", "\[CircleTimes]", " ", "y"}], ")"}]}]}]}], "Input",Expre\
ssionUUID->"440da23f-89b7-4bc4-b802-4371ef8a128b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"x", " ", "\[CirclePlus]", " ", "y"}], ")"}], " ", "\[CircleTimes]",
   " ", 
  RowBox[{"(", 
   RowBox[{"x", " ", "\[CirclePlus]", " ", "y"}], ")"}]}]], "Input",Expression\
UUID->"a207e983-b2cb-4118-b1b9-f9c69ef465db"],

