         RowBox[{"(", 
          RowBox[{"x", " ", "+", " ", "y"}], ")"}], "^", "2"}]}]}], " ", "=", 
      " ", "0"}], " ", "*)"}]}]}]}]], "Input",ExpressionUUID->"60750346-6a4c-\
4c82-8689-0aea6dc69cca"],

