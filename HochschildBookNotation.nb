Cell["4. Cochains and the Hochschild differential", "Section",ExpressionUUID->"ea3b025e-8a50-4798-b9f4-45d8afc2a4ea"],

Cell[TextData[{
 "On ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "3"], ")"}], TraditionalForm]],ExpressionUUID->
  "19eb5d3e-9571-49eb-adee-e76c2500fe5b"],
 " a 1-cocycle is a derivation, ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"\[ScriptCapitalD]", "(", 
       RowBox[{"a", "\[CircleTimes]", "b"}], ")"}], "\[LongEqual]", 
      RowBox[{
       RowBox[{
        RowBox[{"\[ScriptCapitalD]", "(", "a", ")"}], "\[CircleTimes]", "b"}],
        "\[CirclePlus]", 
       RowBox[{"a", "\[CircleTimes]", 
        RowBox[{"\[ScriptCapitalD]", "(", "b", ")"}]}]}]}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "5209410c-d203-4c76-ad8a-456bb74bbd73"],
 ":"
}], "Text",ExpressionUUID->"32d185f4-3f4b-4dab-b473-529b4cd0a754"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"TruncatedPolynomial", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x", ",", " ", "x2"}], "}"}], " ", "=", " ", 
   RowBox[{"gens", " ", "=", " ", 
    RowBox[{"Generators", "[", "B", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"der", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"B", ",", " ", 
     RowBox[{"First", "@", 
      RowBox[{"HHBasis", "[", 
       RowBox[{"B", ",", " ", "1"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"der", "[", "x", "]"}]}], "Input",ExpressionUUID->"0b66a16c-e949-\
419f-aba1-6493c54b1ae1"],

Cell[BoxData[
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"der", "[", 
       RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], "]"}], " ", "==", " ", 
      
      RowBox[{
       RowBox[{
        RowBox[{"der", "[", "a", "]"}], " ", "\[CircleTimes]", " ", "b"}], 
       " ", "\[CirclePlus]", " ", 
       RowBox[{"a", " ", "\[CircleTimes]", " ", 
        RowBox[{"der", "[", "b", "]"}]}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "gens"}], "}"}]}], "]"}]}]}]], "Input",Expression\
UUID->"36b6d52c-73b0-4446-9bbf-15da24e905e7"],

Cell["\<\
The differential of a 2-cochain, exactly as written in the books:\
\>", "Text",ExpressionUUID->"5b1a832c-dfd4-4fa4-9677-4d6417523218"],

Cell[BoxData[
 FormBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]", "(", "\[Phi]", ")"}], "\[InvisibleApplication]", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b", ",", "c"}], ")"}]}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"a", "\[CircleTimes]", 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"b", ",", "c"}], ")"}]}], "\[CirclePlus]", 
      RowBox[{"-", 
       RowBox[{"\[Phi]", "(", 
        RowBox[{
         RowBox[{"a", "\[CircleTimes]", "b"}], ",", "c"}], ")"}]}], "\[CirclePlus]", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"a", ",", 
        RowBox[{"b", "\[CircleTimes]", "c"}]}], ")"}], "\[CirclePlus]", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"a", ",", "b"}], ")"}], "\[CircleTimes]", "c"}], ")"}]}]}]}],
    HoldForm],
   TraditionalForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"38f74643-373f-413f-bd6c-c881d7af2780"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"\[Phi]", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"B", ",", " ", 
     RowBox[{"RandomCochain", "[", 
      RowBox[{"B", ",", " ", "2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", "\[Phi]", "]"}], "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"a", " ", "\[CircleTimes]", " ", 
        RowBox[{"\[Phi]", "[", 
         RowBox[{"b", ",", " ", "c"}], "]"}]}], " ", "\[CirclePlus]", " ", 
       RowBox[{"-", 
        RowBox[{"\[Phi]", "[", 
         RowBox[{
          RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], ",", " ", "c"}], 
         "]"}]}], " ", "\[CirclePlus]", " ", 
       RowBox[{"\[Phi]", "[", 
        RowBox[{"a", ",", " ", 
         RowBox[{"b", " ", "\[CircleTimes]", " ", "c"}]}], "]"}], " ", "\[CirclePlus]",
        " ", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"a", ",", " ", "b"}], "]"}], " ", "\[CircleTimes]", " ", 
          "c"}], ")"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "gens"}], "}"}]}], "]"}]}]}]}], "Input",Expressio\
nUUID->"43d17e34-c315-4fb6-aa68-ff7aca7cfe80"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]", "[", 
   RowBox[{"\[Delta]", "[", "\[Phi]", "]"}], "]"}], " ", "==", " ", 
  "0"}]], "Input",ExpressionUUID->"44757bed-9f71-4918-9a23-af990da7732f"],

Cell[TextData[{
 "The cup product ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"f", "\[CircleTimes]", "g"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "b931263a-8452-47cf-8372-bbfe51a28c2e"],
 " evaluates as ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"f", "\[CircleTimes]", "g"}], ")"}], "\[InvisibleApplication]", 
       RowBox[{"(", 
        RowBox[{"a", ",", "b", ",", "c"}], ")"}]}], "\[LongEqual]", 
      RowBox[{
       RowBox[{"f", "(", "a", ")"}], "\[CircleTimes]", 
       RowBox[{"g", "(", 
        RowBox[{"b", ",", "c"}], ")"}]}]}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "376467c2-ead6-4086-841a-537409e8b55a"],
 ", and \[Delta] is a graded derivation of it:"
}], "Text",ExpressionUUID->"4f182453-ab0f-4c5f-aca5-aad1d0e6f02b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"B", ",", " ", 
     RowBox[{"RandomCochain", "[", 
      RowBox[{"B", ",", " ", "1"}], "]"}]}], "]"}]}], ";", " ", 
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"B", ",", " ", 
     RowBox[{"RandomCochain", "[", 
      RowBox[{"B", ",", " ", "2"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"f", " ", "\[CircleTimes]", " ", "g"}], ")"}], "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], " ", "==", " ", 
      RowBox[{
       RowBox[{"f", "[", "a", "]"}], " ", "\[CircleTimes]", " ", 
       RowBox[{"g", "[", 
        RowBox[{"b", ",", " ", "c"}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "gens"}], "}"}]}], "]"}]}]}]}], "Input",Expressio\
nUUID->"a2361ec0-610d-41cb-97b7-2821905d6c26"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]", "[", 
   RowBox[{"f", " ", "\[CircleTimes]", " ", "g"}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Delta]", "[", "f", "]"}], " ", "\[CircleTimes]", " ", "g"}], 
   " ", "\[CirclePlus]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", "1"}], " ", 
    RowBox[{"f", " ", "\[CircleTimes]", " ", 
     RowBox[{"\[Delta]", "[", "g", "]"}]}]}]}]}]], "Input",ExpressionUUID->\
"70cbb1bc-254b-4755-a37a-c23fb8e50fc0"],

Cell["5. Deformations in book notation", "Section",ExpressionUUID->"3e3f83e9-9b85-4b9b-8e84-cabed7e2f038"],

Cell[TextData[{
 "The class in ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     TemplateBox[{"HH", "2"},
      "Superscript"],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "d3509971-cbee-4367-ac74-f606c7032dcc"],
 " of the dual numbers deforms the product to ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{
      RowBox[{"x", "\[CircleTimes]", "x"}], "\[LongEqual]", 
      RowBox[{"-", "t"}]}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "5701f7f2-8ca3-4b43-9c13-7ead0034936e"],
 ", which stays associative for every t:"
}], "Text",ExpressionUUID->"b2e04c03-374f-4f06-b0a9-a23ed66cd2a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"D0", " ", "=", " ", 
   RowBox[{"DualNumbers", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"At", " ", "=", " ", 
   RowBox[{"HochschildAlgebra", "[", 
    RowBox[{"\"\<k[x]/(x^2 + t)\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<1\>\"", ",", " ", "\"\<x\>\""}], "}"}], ",", " ", 
     RowBox[{"DeformedStructureConstants", "[", 
      RowBox[{"D0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"First", "@", 
         RowBox[{"HHBasis", "[", 
          RowBox[{"D0", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", "t"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x"}], "}"}], " ", "=", " ", 
   RowBox[{"gens", " ", "=", " ", 
    RowBox[{"Generators", "[", "At", "]"}]}]}], ";"}], "\n", 
 RowBox[{"x", " ", "\[CircleTimes]", " ", "x"}]}], "Input",ExpressionUUID->\
"03ef1b87-dc3c-47e3-b1fa-166439d03cfe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"one", " ", "\[CirclePlus]", " ", "x"}], ")"}], " ", "\[CircleTimes]",
   " ", 
  RowBox[{"(", 
   RowBox[{"one", " ", "\[CirclePlus]", " ", 
    RowBox[{"-", "x"}]}], ")"}]}]], "Input",ExpressionUUID->"95479411-95a8-\
48cc-a663-bc3754d7828c"],

Cell[BoxData[
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], ")"}], " ", "\[CircleTimes]",
        " ", "c"}], " ", "==", " ", 
      RowBox[{"a", " ", "\[CircleTimes]", " ", 
       RowBox[{"(", 
        RowBox[{"b", " ", "\[CircleTimes]", " ", "c"}], ")"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "gens"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "gens"}], "}"}]}], "]"}]}]}]], "Input",Expression\
UUID->"d0bf4881-9cf1-460a-a169-22d192bf6bb8"],

Cell["\<\
The quantum plane at q = 1 - t: the commutator measures the first-order term.\
\
\>", "Text",ExpressionUUID->"38b32f1c-93b2-4685-8aec-a95eb7273766"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Qt", " ", "=", " ", 
   RowBox[{"QuantumPlane", "[", 
    RowBox[{"1", " ", "-", " ", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x", ",", " ", "y", ",", " ", "xy"}], "}"}], " ",
    "=", " ", 
   RowBox[{"Generators", "[", "Qt", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"y", " ", "\[CircleTimes]", " ", "x"}], " ", "\[CirclePlus]", " ", 
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{"x", " ", "\[CircleTimes]", " ", "y"}], ")"}]}]}]}], "Input",Expre\
ssionUUID->"c3fe97ad-625f-405b-8ac6-5e9d0341d420"],

Cell["6. The Jacobi identity for the Gerstenhaber bracket", "Section",ExpressionUUID->"48f618bc-ed96-45c7-ab23-dc8b0cad793d"],

Cell[TextData[{
 "The composition ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"f", "\[SmallCircle]", "g"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "3fb61845-bed4-4d79-8cb7-faaef5d2a049"],
 " (Esc sc Esc) inserts g into f with the Koszul signs, and the Gerstenhaber \
bracket is written exactly as in the books, with |f| = p, |g| = q:"
}], "Text",ExpressionUUID->"fdc38b1c-77e5-4b5f-b9ba-3de54bc94584"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"[", "f", ",", "g", "]"}], "=", 
   RowBox[{"f", "\[SmallCircle]", "g"}], "\[CirclePlus]", 
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"(", "p", "-", "1", ")", "(", "q", "-", "1", ")"}]]}], 
   RowBox[{"g", "\[SmallCircle]", "f"}]}], TraditionalForm]], "DisplayFormula",\
ExpressionUUID->"15864340-3d58-448b-876a-f6e176672ad7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"deg", "[", 
    RowBox[{"Coch", "[", 
     RowBox[{"_", ",", " ", "f_"}], "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"CochainDegree", "[", "f", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Coch", " ", "/:", " ", 
   RowBox[{"SmallCircle", "[", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "f_"}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"A_", ",", " ", "g_"}], "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"GCircle", "[", 
      RowBox[{"f", ",", " ", "g"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bracket", "[", 
    RowBox[{"f_Coch", ",", " ", "g_Coch"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"f", " ", "\[SmallCircle]", " ", "g"}], " ", "\[CirclePlus]", " ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"deg", "[", "f", "]"}], " ", "-", " ", "1"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"deg", "[", "g", "]"}], " ", "-", " ", "1"}], ")"}]}], 
        ")"}]}]}], " ", 
     RowBox[{"(", 
      RowBox[{"g", " ", "\[SmallCircle]", " ", "f"}], ")"}]}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"162c4de8-9c09-48c2-a130-9f3ab362a7cb"],

Cell["The graded Jacobi identity, for f, g, h of degrees p, q, r:", "Text",ExpressionUUID->"afd4493f-57f7-44a8-8b78-6c21353647d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"(", "p", "-", "1", ")", "(", "r", "-", "1", ")"}]], 
   RowBox[{"[", "f", ",", 
    RowBox[{"[", "g", ",", "h", "]"}], "]"}], "\[CirclePlus]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"(", "q", "-", "1", ")", "(", "p", "-", "1", ")"}]], 
   RowBox[{"[", "g", ",", 
    RowBox[{"[", "h", ",", "f", "]"}], "]"}], "\[CirclePlus]", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"(", "r", "-", "1", ")", "(", "q", "-", "1", ")"}]], 
   RowBox[{"[", "h", ",", 
    RowBox[{"[", "f", ",", "g", "]"}], "]"}], "=", "0"}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"2447ba1a-6a17-49d5-\
b77e-1dae7a43d5db"],

Cell[TextData[{
 "One instance on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "3"], ")"}], TraditionalForm]],ExpressionUUID->
  "7d274a9a-bb73-42fa-b903-4b2b5324d1fd"],
 ", with random cochains of degrees 2, 1, 2:"
}], "Text",ExpressionUUID->"7c1b262b-825b-44a0-8322-fa1aa08cd324"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"jacobi", "[", 
    RowBox[{"f_", ",", " ", "g_", ",", " ", "h_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"deg", "[", "f", "]"}]}], ",", " ", 
       RowBox[{"q", " ", "=", " ", 
        RowBox[{"deg", "[", "g", "]"}]}], ",", " ", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"deg", "[", "h", "]"}]}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"p", " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"r", " ", "-", " ", "1"}], ")"}]}], ")"}]}], " ", 
       RowBox[{"Bracket", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"Bracket", "[", 
          RowBox[{"g", ",", " ", "h"}], "]"}]}], "]"}]}], " ", "\[CirclePlus]",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"p", " ", "-", " ", "1"}], ")"}]}], ")"}]}], " ", 
       RowBox[{"Bracket", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Bracket", "[", 
          RowBox[{"h", ",", " ", "f"}], "]"}]}], "]"}]}], " ", "\[CirclePlus]",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"q", " ", "-", " ", "1"}], ")"}]}], ")"}]}], " ", 
       RowBox[{"Bracket", "[", 
        RowBox[{"h", ",", " ", 
         RowBox[{"Bracket", "[", 
          RowBox[{"f", ",", " ", "g"}], "]"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", ",", " ", "g", ",", " ", "h"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"B", ",", " ", 
       RowBox[{"RandomCochain", "[", 
        RowBox[{"B", ",", " ", "2"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"B", ",", " ", 
       RowBox[{"RandomCochain", "[", 
        RowBox[{"B", ",", " ", "1"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"Coch", "[", 
      RowBox[{"B", ",", " ", 
       RowBox[{"RandomCochain", "[", 
        RowBox[{"B", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"jacobi", "[", 
   RowBox[{"f", ",", " ", "g", ",", " ", "h"}], "]"}], " ", "==", " ", 
  "0"}]}], "Input",ExpressionUUID->"e9b7d2da-d8f0-4871-aa26-1c8e4041d30c"],

Cell["\<\
Every combination of degrees p, q, r from 0 to 2, each with fresh random \
cochains:\
\>", "Text",ExpressionUUID->"64da70cb-1e9a-435e-8282-11549e0e1260"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"jacobi", "[", 
       RowBox[{
        RowBox[{"Coch", "[", 
         RowBox[{"B", ",", " ", 
          RowBox[{"RandomCochain", "[", 
           RowBox[{"B", ",", " ", "p"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"Coch", "[", 
         RowBox[{"B", ",", " ", 
          RowBox[{"RandomCochain", "[", 
           RowBox[{"B", ",", " ", "q"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"Coch", "[", 
         RowBox[{"B", ",", " ", 
          RowBox[{"RandomCochain", "[", 
           RowBox[{"B", ",", " ", "r"}], "]"}]}], "]"}]}], "]"}], " ", "==", 
      " ", "0"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"p", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"q", ",", " ", "0", ",", " ", "2"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}], " ", "//", 
   " ", "Flatten"}], " ", "//", " ", "Counts"}]], "Input",ExpressionUUID->\
"5fa851b1-4617-4496-a7e0-5e5ea514a6f3"],

Cell[TextData[{
 "Graded antisymmetry, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", "f", ",", "g", "]"}], "=", 
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], 
      RowBox[{"(", "p", "-", "1", ")", "(", "q", "-", "1", ")"}]]}], 
    RowBox[{"[", "g", ",", "f", "]"}]}], TraditionalForm]],ExpressionUUID->
  "f7e5fd22-2d26-4e09-b8a3-bd96a415649e"],
 ", and the differential as a bracket with the product, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Delta]", "f"}], "=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], 
     RowBox[{"p", "-", "1"}]], 
    RowBox[{"[", "\[Mu]", ",", "f", "]"}]}], TraditionalForm]],ExpressionUUID->
  "a9628978-a1e2-42aa-a1ae-cf04a9cd0d63"],
 ":"
}], "Text",ExpressionUUID->"f6a3dbd4-e7cc-430d-9a29-0f97508ed944"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Bracket", "[", 
   RowBox[{"f", ",", " ", "g"}], "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"deg", "[", "f", "]"}], " ", "-", " ", "1"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"deg", "[", "g", "]"}], " ", "-", " ", "1"}], ")"}]}], 
      ")"}]}]}], " ", 
   RowBox[{"Bracket", "[", 
    RowBox[{"g", ",", " ", "f"}], "]"}]}]}]], "Input",ExpressionUUID->\
"4bec6d9c-acf6-4a63-a069-6bb6594551a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"B", ",", " ", 
     RowBox[{"Mu", "[", "B", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]", "[", "f", "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"deg", "[", "f", "]"}], " ", "-", " ", "1"}], ")"}]}], " ", 
   RowBox[{"Bracket", "[", 
    RowBox[{"\[Mu]", ",", " ", "f"}], "]"}]}]}]}], "Input",ExpressionUUID->\
"f2851c1a-a28f-437a-80d6-ad152b2d3df5"],

Cell[TextData[{
 "On cohomology classes the bracket of cocycles is again a cocycle, and the \
Jacobi identity holds in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "*"], TraditionalForm]],ExpressionUUID->
  "43f29bbf-9245-4b6f-b2ea-6534ed31c558"],
 ". Here on the cocycles representing ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "1"], TraditionalForm]],ExpressionUUID->
  "3ff9f28d-bfe3-4082-a1d6-80585f4d1f3e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "2"], TraditionalForm]],ExpressionUUID->
  "91f291bc-74ce-4784-a6cc-5a6660ad2808"],
 " of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "3"], ")"}], TraditionalForm]],ExpressionUUID->
  "7f127324-e14f-4bd6-a149-7717215b5081"],
 ":"
}], "Text",ExpressionUUID->"c9517bbc-9a2a-431e-b31a-ac5f500c1d2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"classes", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Coch", "[", 
      RowBox[{"B", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"HHBasis", "[", 
       RowBox[{"B", ",", " ", "1"}], "]"}], ",", " ", 
      RowBox[{"HHBasis", "[", 
       RowBox[{"B", ",", " ", "2"}], "]"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[Delta]", "[", 
        RowBox[{"Bracket", "[", 
         RowBox[{"u", ",", " ", "v"}], "]"}], "]"}], " ", "==", " ", "0"}], 
      " ", "&&", " ", 
      RowBox[{
       RowBox[{"jacobi", "[", 
        RowBox[{"u", ",", " ", "v", ",", " ", "w"}], "]"}], " ", "==", " ", 
       "0"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"u", ",", " ", "classes"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"v", ",", " ", "classes"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"w", ",", " ", "classes"}], "}"}]}], "]"}]}]}]}], "Input",Expres\
sionUUID->"8535b5cf-dec5-4225-be8a-7d1aefc81cc5"],

Cell["7. Motivating examples for each degree", "Section",ExpressionUUID->"c3bdee08-086b-49de-a619-377cb95178ca"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "0"], TraditionalForm]],ExpressionUUID->
  "1b9319e6-f2ba-4f9e-9f79-0b5d0bc81025"],
 ": the elements that commute with everything"
}], "Subsection",ExpressionUUID->"ce1a5629-6432-4a7a-9d56-fa0084bc36fa"],

Cell["\<\
The coboundary of an element is its commutator with everything else. In the \
quantum plane, x and y do not commute unless q = 1, but xy commutes with \
every element:\
\>", "Text",ExpressionUUID->"9458e5a2-6def-4b55-80bf-877ef0dcb133"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"QuantumPlane", "[", "q", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x", ",", " ", "y", ",", " ", "xy"}], "}"}], " ",
    "=", " ", 
   RowBox[{"Generators", "[", "A", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cx", " ", "=", " ", 
    RowBox[{"Coch", "[", 
     RowBox[{"A", ",", " ", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"the", " ", "element", " ", "x"}], ",", " ", 
    RowBox[{
     RowBox[{"viewed", " ", "as", " ", "a", " ", "0"}], "-", "cochain"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", "cx", "]"}], "[", "y", "]"}], " ", "==", " ", 
  RowBox[{
   RowBox[{"y", " ", "\[CircleTimes]", " ", "x"}], " ", "\[CirclePlus]", " ", 
   
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"x", " ", "\[CircleTimes]", " ", "y"}], ")"}]}]}]}]}], "Input",Ex\
pressionUUID->"9d8e8cab-41a3-4aeb-965e-2187934b2ba1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", "cx", "]"}], "[", "y", "]"}], 
  "                    ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"q", " ", "-", " ", "1"}], ")"}], " ", 
     RowBox[{"xy", " ", ":", " ", 
      RowBox[{
      "x", " ", "commutes", " ", "with", " ", "y", " ", "only", " ", "when", " ",
        "q"}]}]}], " ", "=", " ", "1"}], " ", "*)"}]}]], "Input",ExpressionUUI\
D->"553f6da0-7c46-46ac-9f2f-83b54227370b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]", "[", 
   RowBox[{"Coch", "[", 
    RowBox[{"A", ",", " ", 
     RowBox[{"xy", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], " ", "==", " ", "0", 
  "     ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"xy", " ", "commutes", " ", "with", " ", 
     RowBox[{"everything", ":", " ", 
      RowBox[{"it", " ", "lies", " ", "in", " ", 
       RowBox[{"HH", "^", "0"}]}]}]}], ",", " ", 
    RowBox[{"the", " ", "centre"}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"1c0672c3-ebf5-490c-a700-c3a9ddbf7b4a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "1"], TraditionalForm]],ExpressionUUID->
  "4de9872a-c9a1-4295-9b3c-751357bed0be"],
 ": derivations are vector fields"
}], "Subsection",ExpressionUUID->"112a87f5-24f5-4ed4-8068-0676798ba08c"],

Cell[TextData[{
 "On ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "3"], ")"}], TraditionalForm]],ExpressionUUID->
  "05f1f292-ef8d-4504-b819-23493d31e0af"],
 " the map x d/dx (the Euler field: it scales ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "8f5ff591-3bbe-4ea5-b849-b89899d9e56d"],
 " by n) satisfies the Leibniz rule, so it is a 1-cocycle. A map that is not \
a derivation has a nonzero coboundary, and the coboundary says exactly how \
badly Leibniz fails:"
}], "Text",ExpressionUUID->"456f3b46-5de9-429c-be5a-784a241de46d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"TruncatedPolynomial", "[", "3", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x", ",", " ", "x2"}], "}"}], " ", "=", " ", 
   RowBox[{"gens", " ", "=", " ", 
    RowBox[{"Generators", "[", "B", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eu", " ", "=", " ", 
    RowBox[{"Coch", "[", 
     RowBox[{"B", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "2"}], "}"}]}], "}"}]}], 
     "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", 
      RowBox[{"d", "/", 
       RowBox[{"dx", " ", ":", " ", "1"}]}]}], " ", "->", " ", "0"}], ",", 
    " ", 
    RowBox[{"x", " ", "->", " ", "x"}], ",", " ", 
    RowBox[{
     RowBox[{"x", "^", "2"}], " ", "->", " ", 
     RowBox[{"2", " ", 
      RowBox[{"x", "^", "2"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"eu", "[", "x", "]"}], ",", " ", 
   RowBox[{"eu", "[", "x2", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"eu", "[", 
     RowBox[{"x", " ", "\[CircleTimes]", " ", "x"}], "]"}], " ", "==", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"eu", "[", "x", "]"}], " ", "\[CircleTimes]", " ", "x"}], " ", "\[CirclePlus]",
      " ", 
     RowBox[{"x", " ", "\[CircleTimes]", " ", 
      RowBox[{"eu", "[", "x", "]"}]}]}]}]}], "}"}]}], "Input",ExpressionUUID->\
"9ce9aaf6-ff6d-46f8-91a6-950bed1b4485"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Delta]", "[", "eu", "]"}], " ", "==", " ", "0", 
  "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "Leibniz", " ", "rule", " ", "is", " ", "exactly", " ", "the", 
    " ", "cocycle", " ", "condition"}], " ", "*)"}]}]], "Input",ExpressionUUID\
->"4e11424c-2cf8-4fd9-ab2f-0e4d93509c21"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"notDer", " ", "=", " ", 
    RowBox[{"Coch", "[", 
     RowBox[{"B", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "}"}]}], 
     "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"x", " ", "->", " ", "x"}], ",", " ", 
    RowBox[{
     RowBox[{"x", "^", "2"}], " ", "->", " ", 
     RowBox[{
      RowBox[{"x", "^", "2"}], " ", ":", " ", 
      RowBox[{"not", " ", "a", " ", "derivation"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", "notDer", "]"}], "[", 
   RowBox[{"x", ",", " ", "x"}], "]"}], "               ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"x", " ", "D", 
     RowBox[{"(", "x", ")"}]}], " ", "-", " ", 
    RowBox[{"D", 
     RowBox[{"(", 
      RowBox[{"x", "^", "2"}], ")"}]}], " ", "+", " ", 
    RowBox[{"D", 
     RowBox[{"(", "x", ")"}], " ", 
     RowBox[{"x", " ", ":", " ", 
      RowBox[{
      "how", " ", "far", " ", "it", " ", "is", " ", "from", " ", 
       "Leibniz"}]}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->"8424e45c-\
a6b6-4161-a884-efcefd7bab74"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HHDimension", "[", 
   RowBox[{"B", ",", " ", "1"}], "]"}], "                  ", 
  RowBox[{"(*", " ", 
   RowBox[{"two", " ", "independent", " ", "vector", " ", 
    RowBox[{"fields", ":", " ", 
     RowBox[{"x", " ", 
      RowBox[{"d", "/", "dx"}], " ", "and", " ", 
      RowBox[{"x", "^", "2"}], " ", 
      RowBox[{"d", "/", "dx"}]}]}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"13a2d414-4880-4ab7-aed6-a5cfa85f9074"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "2"], TraditionalForm]],ExpressionUUID->
  "0ffe67be-6137-48ba-bcf7-b1b1afe38216"],
 ": bending the product"
}], "Subsection",ExpressionUUID->"534229c0-439f-4d46-a738-4ebb4fdae070"],

Cell[TextData[{
 "A 2-cocycle \[Phi] bends the multiplication to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "\[CircleTimes]", "b"}], "\[CirclePlus]", 
    RowBox[{"t", " ", 
     RowBox[{"\[Phi]", "(", 
      RowBox[{"a", ",", "b"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "e32f481e-62db-42d0-a016-b19f9ee38b93"],
 ". For the dual numbers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "69df28e4-1d59-4189-8e18-8466d1f53a94"],
 " the only bend is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "=", 
    RowBox[{"-", "t"}]}], TraditionalForm]],ExpressionUUID->
  "9a4c4e60-326c-4bda-b848-bf0082609a10"],
 ". Geometrically, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "[", "x", "]", "/", "(", 
    SuperscriptBox["x", "2"], ")"}], TraditionalForm]],ExpressionUUID->
  "5f97c830-d001-4e64-a1fe-ca78f8306e19"],
 " is a double point: a point carrying one tangent direction. The bend pulls \
it apart into two separate points."
}], "Text",ExpressionUUID->"659683d5-9d11-4005-b041-8b2ec8128bf4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"D0", " ", "=", " ", 
   RowBox[{"DualNumbers", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"one", ",", " ", "x"}], "}"}], " ", "=", " ", 
   RowBox[{"Generators", "[", "D0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Phi]", " ", "=", " ", 
   RowBox[{"Coch", "[", 
    RowBox[{"D0", ",", " ", 
     RowBox[{"First", "@", 
      RowBox[{"HHBasis", "[", 
       RowBox[{"D0", ",", " ", "2"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"star", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"a", " ", "\[CircleTimes]", " ", "b"}], " ", "\[CirclePlus]", 
     " ", 
     RowBox[{"t", " ", 
      RowBox[{"\[Phi]", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}]}]}]}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "bent", " ", "product"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"star", "[", 
   RowBox[{"x", ",", " ", "x"}], "]"}], "                          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"x", " ", "x"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "t"}], " ", "instead", " ", "of", " ", "0"}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"e1c1e244-c3bb-4c1b-96be-521c09fb0526"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Delta]", "[", "\[Phi]", "]"}], " ", "==", " ", "0"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"star", "[", 
      RowBox[{
       RowBox[{"star", "[", 
        RowBox[{"x", ",", " ", "x"}], "]"}], ",", " ", "x"}], "]"}], " ", "==",
      " ", 
     RowBox[{"star", "[", 
      RowBox[{"x", ",", " ", 
       RowBox[{"star", "[", 
        RowBox[{"x", ",", " ", "x"}], "]"}]}], "]"}]}]}], "}"}], "    ", 
  RowBox[{"(*", " ", 
   RowBox[{"the", " ", "bend", " ", "respects", " ", "associativity"}], " ", 
   "*)"}]}]], "Input",ExpressionUUID->"b82b683b-cad5-4407-b3e6-3f8652610089"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"X", "^", "2"}], " ", "==", " ", 
     RowBox[{"-", "t"}]}], ",", " ", "X"}], "]"}], " ", "/.", " ", 
  RowBox[{"t", " ", "->", " ", 
   RowBox[{"-", "1", "      ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"at", " ", "t"}], " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], " ", "the", " ", "double", " ", "point", " ", 
         RowBox[{"x", "^", "2"}]}], " ", "=", " ", 
        RowBox[{
         RowBox[{
         "0", " ", "splits", " ", "into", " ", "the", " ", "two", " ", 
          "points", " ", "x"}], " ", "=", " ", "1"}]}]}], ",", " ", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"-", "1"}]}]}], " ", "*)"}]}]}]}]], "Input",ExpressionUUID->\
"93f57736-c833-4d0b-b170-e7abdc95419e"],

Cell[TextData[{
 "A coboundary only bends the product by a change of coordinates, which is \
why ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "2"], TraditionalForm]],ExpressionUUID->
  "9abd075f-bc97-498b-b227-697047bd2b90"],
 " counts the genuinely different deformations:"
}], "Text",ExpressionUUID->"b7858557-b2da-49dc-af8a-9b18b459345c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", " ", "=", " ", 
    RowBox[{"Coch", "[", 
     RowBox[{"D0", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}]}], "]"}]}], ";"}], 
  "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"g", 
      RowBox[{"(", "1", ")"}]}], " ", "=", " ", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"g", 
      RowBox[{"(", "x", ")"}]}], " ", "=", " ", "1"}]}], " ", "*)"}]}], "\n", 

 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"CoboundaryQ", "[", 
     RowBox[{"D0", ",", " ", 
      RowBox[{
       RowBox[{"\[Delta]", "[", "g", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"CoboundaryQ", "[", 
     RowBox[{"D0", ",", " ", 
      RowBox[{"\[Phi]", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "a", " ", "coboundary", " ", "only", " ", "changes", " ", "coordinates"}],
     ";", " ", 
    RowBox[{"\[Phi]", " ", "is", " ", "a", " ", "genuine", " ", "bend"}]}], 
   " ", "*)"}]}]}], "Input",ExpressionUUID->"a30d1f3c-e442-4289-9f11-\
1f7372df4e1d"],

Cell[TextData[{
 "One step further, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "3"], TraditionalForm]],ExpressionUUID->
  "27e299f7-76ea-499c-b6a9-23ba9d7a5825"],
 " holds the obstructions: a bend that works to first order may fail to \
extend to all orders, and the failure is a class in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["HH", "3"], TraditionalForm]],ExpressionUUID->
  "6a17aa8b-c91d-4889-81c2-aa25b89f44b2"],
 ", as in section 5."
}], "Text",ExpressionUUID->"0b45d8f9-601a-45d3-98ee-6f89478a0e4d"],

Cell["\[Copyright] Computational Classnotes \[CenterDot] CC BY-NC-SA 4.0", \
"Text",ExpressionUUID->"ae7662ed-8713-4164-852e-4cf21a7a0855"]
},
