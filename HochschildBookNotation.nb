     RowBox[{"3", " ", "b"}]}], ")"}]}], "]"}]], "Input",ExpressionUUID->\
"5d91617a-059b-43a4-91db-f6d6f36140f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BookExpand", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", " ", "\[CirclePlus]", " ", "b"}], ")"}], " ", "\[CircleTimes]",
