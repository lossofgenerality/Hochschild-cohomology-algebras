Cell["\<\
In three dimensions: the surface of a tetrahedron, with a temperature on each \
vertex (red), the change of temperature along each edge (blue arrows) and a \
flux through each face (green, shaded by value).\
\>", "Text",ExpressionUUID->"51e3d484-f0d4-45e6-ac01-c9f376712319"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", 
     RowBox[{"tetrahedron", ":", " ", 
      RowBox[{"4", " ", "vertices"}]}]}], ",", " ", 
    RowBox[{"6", " ", "edges"}], ",", " ", 
    RowBox[{"4", " ", "triangular", " ", "faces"}], ",", " ", 
    RowBox[{
    "all", " ", "oriented", " ", "by", " ", "increasing", " ", "vertex", " ", 
     "number"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tv", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}], ",", " ", "0"}], "}"}],
        ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "6"}], ",", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", "/", "3"}], "]"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"te", " ", "=", " ", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tf", " ", "=", " ", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Range", "[", "4", "]"}], ",", " ", 
       RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"f3", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "1", ",", " ", "4", ",", " ", "2"}], "}"}]}], 
    ";"}], "                                          ", 
   RowBox[{"(*", " ", 
    RowBox[{"0", "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{
      "a", " ", "temperature", " ", "at", " ", "each", " ", "vertex"}]}]}], 
