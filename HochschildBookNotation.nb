      TextCell[
       Style["deg[f]", FontFamily -> "Source Code Pro", FontSize -> 12]]], 
     FormBox[
      RowBox[{
       RowBox[{"\[LeftBracketingBar]", "f", "\[RightBracketingBar]"}], "=", 
       "p"}],
      TraditionalForm]},
    {
     InterpretationBox[Cell[BoxData[
       StyleBox["\<\"f[a1, ..., ap]\"\>",
        StripOnInput->False,
        FontFamily->"Source Code Pro",
        FontSize->12]],ExpressionUUID->"d6871587-afd6-4ace-87ed-01d7693dd8ee"],
      TextCell[
       Style[
       "f[a1, ..., ap]", FontFamily -> "Source Code Pro", FontSize -> 12]]], 
     FormBox[
      RowBox[{"f", "(", 
       SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", 
       SubscriptBox["a", "p"], ")"}],
      TraditionalForm]},
    {
