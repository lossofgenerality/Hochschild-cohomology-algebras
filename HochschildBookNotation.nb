Cell[TextData[{
 "The coboundary \[Delta] turns a p-cochain into a (p+1)-cochain by adding up \
its values around the boundary, with signs. On points it is a discrete \
gradient: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Delta]", "f"}], ")"}], "(", 
    RowBox[{"i", "\[Rule]", "j"}], ")", "=", 
    RowBox[{"f", "(", "j", ")"}], "-", 
    RowBox[{"f", "(", "i", ")"}]}], TraditionalForm]],ExpressionUUID->
  "a4aea3d4-fdfd-4019-a0d1-f5486c738817"],
 ". On edges it is a discrete curl. The rule ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Delta]", "2"], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"de8408d0-16a2-42af-8977-2e479eba5754"],
 " says the curl of a gradient vanishes."
}], "Text",ExpressionUUID->"0c11c353-8ced-40b2-8630-7dad71eb5d9c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"a", " ", "circle", " ", "drawn", " ", "as", " ", "a", " ", 
     RowBox[{"triangle", ":", " ", 
      RowBox[{"vertices", " ", "1"}]}]}], ",", " ", "2", ",", " ", 
    RowBox[{
     RowBox[{"3", " ", "and", " ", "edges", " ", "1"}], "->", "2"}], ",", " ", 
    RowBox[{"2", "->", "3"}], ",", " ", 
    RowBox[{"3", "->", "1"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edges", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d0", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"v", " ", "==", " ", 
          RowBox[{"e", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", "1", ",", " ", 
         RowBox[{"v", " ", "==", " ", 
          RowBox[{"e", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", "True", ",", " ", "0"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "edges"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"v", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "\[Delta]f", ")"}], 
      RowBox[{"(", 
       RowBox[{"i", "->", "j"}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"f", 
       RowBox[{"(", "j", ")"}]}], " ", "-", " ", 
      RowBox[{"f", 
       RowBox[{"(", "i", ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"f0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "7", ",", " ", "2"}], "}"}]}], ";"}], "       ", 
   
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"a", " ", "0"}], "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{"a", " ", "number", " ", "on", " ", "each", " ", "vertex"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{"d0", " ", ".", " ", "f0", "              ", 
    RowBox[{"(*", " ", 
     RowBox[{"its", " ", 
      RowBox[{"coboundary", ":", " ", 
       RowBox[{
       "the", " ", "change", " ", "of", " ", "f", " ", "along", " ", "each", " ",
         "edge"}]}]}], " ", "*)"}]}]}]}]], "Input",ExpressionUUID->"08bf8042-\
e1f0-4517-ac03-b52550fd06ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Total", "[", 
   RowBox[{"d0", " ", ".", " ", "f0"}], "]"}], "       ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"going", " ", "once", " ", "around", " ", "the", " ", "loop"}], ",",
     " ", 
    RowBox[{
    "the", " ", "changes", " ", "always", " ", "add", " ", "up", " ", "to", " ",
      "0"}]}], " ", "*)"}]}]], "Input",ExpressionUUID->"6a69f8b2-9952-4f81-\
9396-bbaa5c378faf"],

Cell[TextData[{
 "A cochain with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", "\[Omega]", "=", "0"}], TraditionalForm]],
  ExpressionUUID->"05812694-2739-4df9-9752-3a5a7947a6e3"],
 " is closed (a cocycle). If it is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Omega]", "=", 
    RowBox[{"\[Delta]", "f"}]}], TraditionalForm]],ExpressionUUID->
  "a607ae30-91d3-4a51-b8b8-967019b092d5"],
 " it is exact (a coboundary). Every exact cochain is closed. A closed \
cochain that is not exact detects a hole: here, the one-unit circulation \
around the triangle."
}], "Text",ExpressionUUID->"1196ed3a-6fe1-425d-abbd-ab128f3ac6c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", "1"}], "-", 
     RowBox[{"cochain", ":", " ", 
      RowBox[{"1", " ", "on", " ", "the", " ", "first", " ", "edge"}]}]}], ",",
     " ", 
    RowBox[{
     RowBox[{"0", " ", "elsewhere"}], ";", " ", 
     RowBox[{"it", " ", "goes", " ", "once", " ", "around"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"Quiet", "@", 
  RowBox[{"Check", "[", 
   RowBox[{
    RowBox[{"LinearSolve", "[", 
     RowBox[{"d0", ",", " ", "\[Omega]"}], "]"}], ",", 
    " ", "\"\<no solution: \[Omega] is not the coboundary of any \
0-cochain\>\""}], "]"}]}]}], "Input",ExpressionUUID->"3d9969cb-6740-4b4a-b420-\
47bdf546656a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "the", " ", "hole", " ", "is", " ", "counted", " ", "by", " ", "the", " ", 
     RowBox[{"cohomology", ":", " ", 
      RowBox[{"dim", " ", 
       RowBox[{"H", "^", "1"}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"dim", 
      RowBox[{"(", 
       RowBox[{"1", "-", "cochains"}], ")"}]}], " ", "-", " ", 
     RowBox[{"rank", 
      RowBox[{"(", "d0", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"3", " ", "-", " ", 
   RowBox[{"MatrixRank", "[", "d0", "]"}]}]}]], "Input",ExpressionUUID->\
"9069416e-7fcf-4d2a-ab54-1057e781b6c3"],

Cell["\<\
Fill the triangle in and the circulation becomes the flux through the face, \
so it is no longer closed and the hole disappears:\
\>", "Text",ExpressionUUID->"4d28071f-1212-46f9-ad1d-e394ac30d132"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"fill", " ", "the", " ", "triangle", " ", 
     RowBox[{"in", ":", " ", 
      RowBox[{"one", " ", "face"}]}]}], ",", " ", 
    RowBox[{
    "whose", " ", "coboundary", " ", "adds", " ", "the", " ", "three", " ", 
     "edge", " ", "values"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"d1", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], "}"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", ".", " ", "d0"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", " ", "-", " ", 
        RowBox[{"MatrixRank", "[", "d1", "]"}]}], ")"}], " ", "-", " ", 
      RowBox[{"MatrixRank", "[", "d0", "]"}]}]}], "}"}], "     ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"\[Delta]\[Delta]", " ", "=", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "the", " ", "hole", " ", "is", " ", 
       RowBox[{"gone", ":", " ", 
        RowBox[{"H", "^", "1"}]}]}], " ", "=", " ", "0"}]}], " ", 
    "*)"}]}]}]], "Input",ExpressionUUID->"dc364cdf-ae63-4f14-8f99-\
54bb6a2aa74b"],

Cell["\<\
So cohomology = closed modulo exact = the holes and twists that cannot be \
removed by changing coordinates. This is the one idea to keep in mind for \
everything below.\
\>", "Text",ExpressionUUID->"2d6d0165-1638-45cc-b5a0-b75f7a5150b5"],

Cell["From geometry to algebra", "Subsection",ExpressionUUID->"3b460fb5-39e3-45e4-ab1f-3f387750eeef"],

Cell[TextData[{
 "Hochschild cohomology runs the same machine on an algebra A. A simplex with \
p+1 corners becomes a string of p elements ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", 
    SubscriptBox["a", "p"], ")"}], TraditionalForm]],ExpressionUUID->
  "3c4c8620-5c2a-4de6-9cb3-41667a88b861"],
 ", and taking a face becomes multiplying two neighbours, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["a", "i"], "\[CircleTimes]", 
    SubscriptBox["a", 
     RowBox[{"i", "+", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "9b2a82d2-4737-40ae-9094-0597ed057f68"],
 ". A p-cochain assigns an element of A to every such string, and \[Delta] is \
the alternating sum over the faces. In low degrees each formula measures a \
familiar failure:"
}], "Text",ExpressionUUID->"eb9f83fe-a9de-414c-8116-9ff26c86e0e5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Delta]", "a"}], ")"}], "(", "x", ")"}], "=", 
   RowBox[{"x", "\[CircleTimes]", "a"}], "\[CirclePlus]", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"a", "\[CircleTimes]", "x"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"828c199c-188d-482e-\
b3ed-941eb36500bb"],

Cell["\<\
how far a is from commuting with x (zero exactly for central elements);\
\>", "Text",ExpressionUUID->"50a6cc56-1106-4997-938f-dbbca187cd2a"],

Cell[BoxData[
 FormBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]", "(", "\[ScriptCapitalD]", ")"}], "\[InvisibleApplication]", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b"}], ")"}]}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"a", "\[CircleTimes]", 
       RowBox[{"\[ScriptCapitalD]", "(", "b", ")"}]}], "\[CirclePlus]", 
      RowBox[{"-", 
       RowBox[{"\[ScriptCapitalD]", "(", 
        RowBox[{"a", "\[CircleTimes]", "b"}], ")"}]}], "\[CirclePlus]", 
      RowBox[{
       RowBox[{"\[ScriptCapitalD]", "(", "a", ")"}], "\[CircleTimes]", 
       "b"}]}]}],
    HoldForm],
   TraditionalForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"d6d0ce33-da5c-438d-bd1f-4e106df1b52c"],

Cell["\<\
how far a linear map is from the Leibniz rule (zero exactly for derivations);\
\
\>", "Text",ExpressionUUID->"6b2234c4-2654-4c7c-a203-cc344dc72815"],

Cell[BoxData[
 FormBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]", "(", "\[Phi]", ")"}], "\[InvisibleApplication]", 
      RowBox[{"(", 
       RowBox[{"a", ",", "b", ",", "c"}], ")"}]}], "\[LongEqual]", 
     RowBox[{
      RowBox[{"a", "\[CircleTimes]", 
       RowBox[{"\[Phi]", "(", 
        RowBox[{"b", ",", "c"}], ")"}]}], "\[CirclePlus]", 
      RowBox[{"-", 
       RowBox[{"\[Phi]", "(", 
        RowBox[{
         RowBox[{"a", "\[CircleTimes]", "b"}], ",", "c"}], ")"}]}], "\[CirclePlus]", 
      RowBox[{"\[Phi]", "(", 
       RowBox[{"a", ",", 
        RowBox[{"b", "\[CircleTimes]", "c"}]}], ")"}], "\[CirclePlus]", 
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Phi]", "(", 
          RowBox[{"a", ",", "b"}], ")"}], "\[CircleTimes]", "c"}], ")"}]}]}]}],
    HoldForm],
   TraditionalForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->\
"647845e1-89cf-4d36-9ea5-492920f219f2"],

Cell[TextData[{
 "how far the bent product ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "\[CircleTimes]", "b"}], "\[CirclePlus]", 
    RowBox[{"t", " ", 
     RowBox[{"\[Phi]", "(", 
      RowBox[{"a", ",", "b"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "4644e829-083d-4f46-88d7-f7c983def535"],
 " is from associative, to first order in t."
}], "Text",ExpressionUUID->"f92c7cc6-527c-4907-988d-856403c1bc1d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["Geometry",
      StripOnInput->False,
      ShowStringCharacters->False,
      FontWeight->Bold], 
     StyleBox[
      RowBox[{"Algebra", " ", 
       RowBox[{"(", "Hochschild", ")"}]}],
      StripOnInput->False,
      ShowStringCharacters->False,
      FontWeight->Bold]},
    {
     InterpretationBox[Cell[
      "a point",ExpressionUUID->"5aa22bf7-caa5-4e57-b11c-013bfc6cd53a"],
      TextCell["a point"]], 
     InterpretationBox[Cell[
      "an element a of A",ExpressionUUID->
       "09776a1b-0a23-404b-8c27-288d5f2c72b2"],
      TextCell["an element a of A"]]},
    {
     InterpretationBox[Cell[
      "a p-simplex",ExpressionUUID->"baaf4a5a-b271-4900-8dbe-4169b1abdff0"],
      TextCell["a p-simplex"]], 
     InterpretationBox[Cell[
      "a string (a1, ..., ap) of p elements",ExpressionUUID->
       "2e791f60-5ba3-4c9f-8e57-80ef815f134e"],
      TextCell["a string (a1, ..., ap) of p elements"]]},
    {
     InterpretationBox[Cell[
      "taking a face",ExpressionUUID->"992f7a1c-5b33-4734-85bc-dded8c169e76"],
      
      TextCell["taking a face"]], 
     TemplateBox[{
       InterpretationBox[
        Cell["multiplying neighbours, "], 
        TextCell["multiplying neighbours, "]], 
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
            SubscriptBox["a", "i"], "\[CircleTimes]", 
            SubscriptBox["a", 
             RowBox[{"i", "+", "1"}]]}], HoldForm], TraditionalForm], 
        TraditionalForm, Editable -> True]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[
      "p-cochain: a number on each p-simplex",ExpressionUUID->
       "a9a40f0f-93fd-40ad-a294-0d129f5952e4"],
      TextCell["p-cochain: a number on each p-simplex"]], 
     InterpretationBox[Cell[
      "p-cochain: an element f(a1, ..., ap) of A",ExpressionUUID->
       "fc47dc40-2685-402b-9bca-9fb5c12184c9"],
      TextCell["p-cochain: an element f(a1, ..., ap) of A"]]},
    {
     InterpretationBox[Cell[
      "gradient, curl, divergence",ExpressionUUID->
       "5f6f2480-0b85-41c4-9e2d-5c23dc015dd2"],
      TextCell["gradient, curl, divergence"]], 
     TemplateBox[{
       InterpretationBox[
        Cell["the Hochschild differential "], 
        TextCell["the Hochschild differential "]], 
       TagBox[
        FormBox[
         TagBox["\[Delta]", HoldForm], TraditionalForm], TraditionalForm, 
        Editable -> True]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[
      "curl of a gradient is 0",ExpressionUUID->
       "3a28eab6-32be-4903-8ced-e53e79717402"],
      TextCell["curl of a gradient is 0"]], 
     TemplateBox[{
       TagBox[
        FormBox[
         TagBox[
          RowBox[{
            SuperscriptBox["\[Delta]", "2"], "\[LongEqual]", "0"}], HoldForm],
          TraditionalForm], TraditionalForm, Editable -> True], 
       InterpretationBox[
        Cell[", which comes from associativity"], 
        TextCell[", which comes from associativity"]]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[
      "closed but not exact: a hole",ExpressionUUID->
       "fe21cf04-a3fb-4f0f-9ed5-3ac0cd64caee"],
      TextCell["closed but not exact: a hole"]], 
     InterpretationBox[Cell[
      "cocycle but not coboundary: a nonzero class in HH",ExpressionUUID->
       "70ea97cb-7066-4dd0-ae34-d6bce94127cd"],
      TextCell["cocycle but not coboundary: a nonzero class in HH"]]},
    {
     InterpretationBox[Cell[
      "a vector field",ExpressionUUID->"4e0fbe5a-3ce8-40a0-aaf7-005cd11f70da"],
      TextCell["a vector field"]], 
     TemplateBox[{
       InterpretationBox[
        Cell["a derivation, a class in "], 
        TextCell["a derivation, a class in "]], 
       TagBox[
        FormBox[
         TagBox[
          
          TemplateBox[{"HH", "1"}, "Superscript", SyntaxForm -> 
           SuperscriptBox], HoldForm], TraditionalForm], TraditionalForm, 
        Editable -> True]},
      "RowDefault"]},
    {
     InterpretationBox[Cell[
      "a Poisson bivector, to be quantized",ExpressionUUID->
       "c3786a3a-96b2-4aa6-ad8f-ba4fe10b5599"],
      TextCell["a Poisson bivector, to be quantized"]], 
     TemplateBox[{
       InterpretationBox[
        Cell["a bend of the product, a class in "], 
        TextCell["a bend of the product, a class in "]], 
       TagBox[
        FormBox[
         TagBox[
          
          TemplateBox[{"HH", "2"}, "Superscript", SyntaxForm -> 
           SuperscriptBox], HoldForm], TraditionalForm], TraditionalForm, 
        Editable -> True]},
      "RowDefault"]}
   },
