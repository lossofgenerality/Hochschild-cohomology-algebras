Cell[BoxData[
 RowBox[{"And", " ", "@@", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", " ", "\[CircleTimes]", " ", 
       RowBox[{"(", 
