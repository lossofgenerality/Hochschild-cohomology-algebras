      RowBox[{
       RowBox[{"a", " ", "+", " ", 
        RowBox[{"0.18", " ", 
         RowBox[{"(", 
          RowBox[{"b", " ", "-", " ", "a"}], ")"}]}]}], ",", " ", 
       RowBox[{"b", " ", "-", " ", 
        RowBox[{"0.18", " ", 
         RowBox[{"(", 
          RowBox[{"b", " ", "-", " ", "a"}], ")"}]}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"faces", "[", "col_", "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{"col", ",", " ", 
