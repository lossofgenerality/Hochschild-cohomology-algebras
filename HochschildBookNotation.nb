Cell[TextData[{
 "Products and sums are written as in the books: ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"a", "\[CircleTimes]", "b"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "45398257-2690-44e8-bbb5-b43da6217fdf"],
 " for the product and ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"a", "\[CirclePlus]", "b"}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "0c053857-6f6d-4437-a315-f6a32158d7b9"],
 " for the sum. Type the symbols with Esc c* Esc and Esc c+ Esc. Scalars \
multiply by juxtaposition, as in ",
 Cell[BoxData[
  FormBox[
   FormBox[
    TagBox[
     RowBox[{"q", " ", 
      RowBox[{"x", "\[CircleTimes]", "y"}]}],
     HoldForm],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "ffd71909-8d97-4d53-bd98-e02d625ca023"],
 ", and -a is the additive inverse. Keep this notebook next to \
HochschildKit.wl."
}], "Text",ExpressionUUID->"243176e1-27de-47e3-8865-dbfb6d9b74de"],

