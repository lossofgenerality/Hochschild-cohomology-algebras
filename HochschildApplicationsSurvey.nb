(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["Applications of Hochschild Cohomology", "Title"],
Cell["Literature Survey and Worked Wolfram Examples", "Subtitle"],
Cell[TextData[{Cell[BoxData[FormBox["\[Copyright]", TraditionalForm]]], " Computational Classnotes ", Cell[BoxData[FormBox["\[CenterDot]", TraditionalForm]]], " CC BY-NC-SA 4.0"}], "Text"],
Cell[BoxData[RowBox[{"DateString", "[", "]"}]], "Input", Evaluatable -> False, Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell[BoxData["\"Wed 18 Nov 2026 01:28:50\""], "Output", Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell[TextData[{"Keep this notebook in the same folder as HochschildKit.wl and HochschildApplications.wl, then choose Evaluation > Evaluate Notebook. Every number in this notebook is computed exactly by these two packages."}], "Text"],
Cell["SetDirectory[NotebookDirectory[]];\nGet[\"HochschildKit.wl\"];\nGet[\"HochschildApplications.wl\"];", "Input"],
Cell["Map of applications", "Section"],
Cell[TextData[{"The literature uses ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "*"], "(", "A", ",", "A", ")"}], TraditionalForm]]], " in eight main ways. Six of them can be seen in finite-dimensional examples and are worked below; the other two (mirror symmetry and closed strings) work with A-infinity categories beyond an exact cochain evaluator, so they are surveyed only."}], "Text"],
Cell[BoxData[GridBox[{{Cell[TextData[{StyleBox["Field", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["What HH does there", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["Representative literature", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["Example", FontWeight -> "Bold"]}]]}, {Cell[TextData[{"Deformation quantization"}]], Cell[TextData[{"First\[Hyphen]order star products live in ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]], "; up to gauge the first\[Hyphen]order term is a Poisson bracket, and formality makes every Poisson bracket quantizable"}]], Cell[TextData[{ButtonBox["Kontsevich 1997", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/abs/q-alg/9709040"], None}, ButtonNote -> "https://arxiv.org/abs/q-alg/9709040"], "; ", ButtonBox["Voronov", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/q-alg/9701017"], None}, ButtonNote -> "https://arxiv.org/pdf/q-alg/9701017"]}]], Cell[TextData[{"1"}]]}, {Cell[TextData[{"Fermions and Clifford algebras"}]], Cell[TextData[{"The Clifford algebra quantizes the exterior algebra; HH decides which Clifford\[Hyphen]Weyl algebras are rigid"}]], Cell[TextData[{ButtonBox["Musson\[Hyphen]Pinczon\[Hyphen]Ushirobira 2009", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://emis.univie.ac.at/journals/SIGMA/2009/028/sigma09-028.pdf"], None}, ButtonNote -> "https://emis.univie.ac.at/journals/SIGMA/2009/028/sigma09-028.pdf"], "; ", ButtonBox["fermionic star products", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://ar5iv.labs.arxiv.org/html/1909.13866"], None}, ButtonNote -> "https://ar5iv.labs.arxiv.org/html/1909.13866"]}]], Cell[TextData[{"2"}]]}, {Cell[TextData[{"Modular representation theory"}]], Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "*"], "(", "k", "G", ")"}], TraditionalForm]]], " splits into group cohomologies of centralisers; products are computable"}]], Cell[TextData[{ButtonBox["Siegel\[Hyphen]Witherspoon 1999", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://resolve.cambridge.org/core/journals/proceedings-of-the-london-mathematical-society/article/hochschild-cohomology-ring-of-a-group-algebra/D64020603DF3A33A9C664F1139B4B9CF"], None}, ButtonNote -> "https://resolve.cambridge.org/core/journals/proceedings-of-the-london-mathematical-society/article/hochschild-cohomology-ring-of-a-group-algebra/D64020603DF3A33A9C664F1139B4B9CF"], "; ", ButtonBox["Liu\[Hyphen]Zhou 2016", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://ems.press/content/serial-article-files/30662?nt=1"], None}, ButtonNote -> "https://ems.press/content/serial-article-files/30662?nt=1"], "; ", ButtonBox["Linckelmann", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://icms.ac.uk/wp-content/uploads/2025/07/Markus-Linckelmann.pdf"], None}, ButtonNote -> "https://icms.ac.uk/wp-content/uploads/2025/07/Markus-Linckelmann.pdf"]}]], Cell[TextData[{"3"}]]}, {Cell[TextData[{"Derived and Morita equivalence"}]], Cell[TextData[{Cell[BoxData[FormBox[SuperscriptBox["HH", "*"], TraditionalForm]]], " with its bracket is a derived invariant; ", Cell[BoxData[FormBox[SuperscriptBox["HH", "1"], TraditionalForm]]], " as a Lie algebra separates algebras"}]], Cell[TextData[{ButtonBox["Keller", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0310221"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0310221"], "; ", ButtonBox["Rickard review", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/2509.06369"], None}, ButtonNote -> "https://arxiv.org/pdf/2509.06369"], "; ", ButtonBox["Taillefer 2017", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/1706.10044v1"], None}, ButtonNote -> "https://arxiv.org/pdf/1706.10044v1"]}]], Cell[TextData[{"4"}]]}, {Cell[TextData[{"Support varieties"}]], Cell[TextData[{"Max\[Hyphen]spectra of ", Cell[BoxData[FormBox[SuperscriptBox["HH", "ev"], TraditionalForm]]], " define support varieties; their dimension is the complexity of the module"}]], Cell[TextData[{ButtonBox["EHSST", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0311311"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0311311"], "; ", ButtonBox["Solberg", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/0811.4506"], None}, ButtonNote -> "https://arxiv.org/pdf/0811.4506"], "; ", ButtonBox["derived invariance", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/1502.04880v1"], None}, ButtonNote -> "https://arxiv.org/pdf/1502.04880v1"]}]], Cell[TextData[{"5"}]]}, {Cell[TextData[{"String topology and BV algebras"}]], Cell[TextData[{"For a symmetric Frobenius algebra ", Cell[BoxData[FormBox[SuperscriptBox["HH", "*"], TraditionalForm]]], " is a BV algebra; the bracket is the failure of ", Cell[BoxData[FormBox["\[CapitalDelta]", TraditionalForm]]], " to be a derivation"}]], Cell[TextData[{ButtonBox["Tradler 2008", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://www.arxiv.org/pdf/math/0210150"], None}, ButtonNote -> "https://www.arxiv.org/pdf/math/0210150"], "; ", ButtonBox["Tradler\[Hyphen]Zeinalian", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0404218"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0404218"], "; ", ButtonBox["Benson\[Hyphen]Kessar\[Hyphen]Linckelmann 2021", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://msp.org/pjm/2021/313-1/p01.xhtml"], None}, ButtonNote -> "https://msp.org/pjm/2021/313-1/p01.xhtml"]}]], Cell[TextData[{"6"}]]}, {Cell[TextData[{"Mirror symmetry, Fukaya categories"}]], Cell[TextData[{"The closed\[Hyphen]open map ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["QH", "*"], "(", "X", ")", "\[LongRightArrow]", SuperscriptBox["HH", "*"], "(", "Fuk", " ", "X", ")"}], TraditionalForm]]], " relates curve counts to category deformations"}]], Cell[TextData[{ButtonBox["Sheridan", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://people.math.harvard.edu/~auroux/schms2015-2020/Penn2015/N.%20Sheridan%20-%20From%20categories%20to%20curve%20counts%20I.pdf"], None}, ButtonNote -> "https://people.math.harvard.edu/~auroux/schms2015-2020/Penn2015/N.%20Sheridan%20-%20From%20categories%20to%20curve%20counts%20I.pdf"], "; ", ButtonBox["Smith, SIGMA 2026", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://imath.kiev.ua/~sigma/2026/013/sigma26-013.pdf"], None}, ButtonNote -> "https://imath.kiev.ua/~sigma/2026/013/sigma26-013.pdf"], "; ", ButtonBox["Batyrev pairs", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/2406.05272"], None}, ButtonNote -> "https://arxiv.org/pdf/2406.05272"]}]], Cell[TextData[{"survey only"}]]}, {Cell[TextData[{"Topological strings, D\[Hyphen]branes"}]], Cell[TextData[{"Closed string states are conjectured to be HH of the open\[Hyphen]string (D\[Hyphen]brane) algebra"}]], Cell[TextData[{ButtonBox["Kapustin\[Hyphen]Rozansky", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/hep-th/0405232v1"], None}, ButtonNote -> "https://arxiv.org/pdf/hep-th/0405232v1"], "; ", ButtonBox["Hofman", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/hep-th/0204157"], None}, ButtonNote -> "https://arxiv.org/pdf/hep-th/0204157"], "; ", ButtonBox["Bergman", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/hep-th/0609225.pdf"], None}, ButtonNote -> "https://arxiv.org/pdf/hep-th/0609225.pdf"]}]], Cell[TextData[{"survey only"}]]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxBackground -> {"Rows" -> {RGBColor[0.93, 0.93, 0.93], None}}, GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.6}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}}]], "Text", LineIndent -> 0, FontSize -> 11, FontFamily -> "Source Sans Pro"],
Cell[TextData[{"Current entry points: the ", ButtonBox["Oberwolfach report Hochschild (Co)Homology and Applications (2024)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://ems.press/doi/10.4171/owr/2024/20"], None}, ButtonNote -> "https://ems.press/doi/10.4171/owr/2024/20"], " and ", ButtonBox["Bustamante's survey for representation theory", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://link.springer.com/content/pdf/10.1007%2Fs40863-016-0047-3.pdf"], None}, ButtonNote -> "https://link.springer.com/content/pdf/10.1007%2Fs40863-016-0047-3.pdf"], ". A further application not worked here: ", ButtonBox["moduli of subalgebras of matrix rings", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/2006.07870"], None}, ButtonNote -> "https://arxiv.org/pdf/2006.07870"], ", where HH controls the local structure of the moduli space."}], "Text"],
Cell[TextData[{"Example 1: deformation quantization, Poisson brackets from ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]]}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"Of the 5 classes in ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]], " of ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", ",", "y", "]", "/", "(", SuperscriptBox["x", "2"], ",", SuperscriptBox["y", "2"], ")"}], TraditionalForm]]], ", exactly one has a nonzero antisymmetric part: the Poisson bracket ", Cell[BoxData[FormBox[RowBox[{"{", "x", ",", "y", "}", "=", RowBox[{"x", "y"}], "/", "2"}], TraditionalForm]]], ", quantized by the quantum plane ", Cell[BoxData[FormBox[RowBox[{"y", "x", "=", "(", "1", "-", "t", ")", "x", "y"}], TraditionalForm]]], ". The other four are commutative (Harrison) deformations whose antisymmetric part is a coboundary."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{"For a commutative algebra write the first-order term of a star product as ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["B", "1"], "=", SubsuperscriptBox["B", "1", "+"], "+", SubsuperscriptBox["B", "1", "-"]}], TraditionalForm]]], ". ", ButtonBox["Kontsevich (1997)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/abs/q-alg/9709040"], None}, ButtonNote -> "https://arxiv.org/abs/q-alg/9709040"], " notes that the symmetric part can be killed by a gauge transformation and that the skew part is a derivation in each argument; associativity at order ", Cell[BoxData[FormBox[SuperscriptBox["t", "2"], TraditionalForm]]], " forces the Jacobi identity, so it is a Poisson bracket. For smooth algebras this is HKR in degree 2, ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "2"], "=", SuperscriptBox["\[CapitalLambda]", "2"], "T"}], TraditionalForm]]], "; truncated algebras are not smooth, so ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]], " also contains commutative deformations such as ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["x", "2"], "=", "t"}], TraditionalForm]]], "."}], "Text"],
Cell["A = QuantumPlane[1];                     (* k[x,y]/(x^2,y^2) *)\nPoissonFromDeformation[A] // Dataset", "Input"],
Cell["w = AntisymmetricPart[HHBasis[A, 2][[4]]];\n{PoissonQ[A, w], CochainForm[A, w]}", "Input"],
Cell[BoxData[GridBox[{{Cell[TextData[{StyleBox["Class in ", FontWeight -> "Bold"], Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]], StyleBox[" (representative)", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["Symmetric part", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["Antisymmetric part", FontWeight -> "Bold"]}]]}, {Cell[TextData[{Cell[BoxData[FormBox[SubscriptBox["h", "1"], TraditionalForm]]], ": ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["y", "2"], "=", "-1"}], TraditionalForm]]]}]], Cell[TextData[{"nontrivial cocycle"}]], Cell[TextData[{"0"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[SubscriptBox["h", "2"], TraditionalForm]]], ": ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["x", "2"], "=", "-1"}], TraditionalForm]]]}]], Cell[TextData[{"nontrivial cocycle"}]], Cell[TextData[{"0"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[SubscriptBox["h", "3"], TraditionalForm]]], ": ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["y", "2"], "=", "-", "x"}], TraditionalForm]]]}]], Cell[TextData[{"nontrivial cocycle"}]], Cell[TextData[{"0"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[SubscriptBox["h", "4"], TraditionalForm]]], ": ", Cell[BoxData[FormBox[RowBox[{"(", "y", ",", "x", ")", "\[RightTeeArrow]", "-", "x", "y"}], TraditionalForm]]]}]], Cell[TextData[{"coboundary"}]], Cell[TextData[{"Poisson bracket ", Cell[BoxData[FormBox[RowBox[{"{", "x", ",", "y", "}", "=", RowBox[{"x", "y"}], "/", "2"}], TraditionalForm]]]}]]}, {Cell[TextData[{Cell[BoxData[FormBox[SubscriptBox["h", "5"], TraditionalForm]]], ": ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["x", "2"], "=", "-", "y"}], TraditionalForm]]]}]], Cell[TextData[{"nontrivial cocycle"}]], Cell[TextData[{"0"}]]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxBackground -> {"Rows" -> {RGBColor[0.93, 0.93, 0.93], None}}, GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.6}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}}]], "Text", LineIndent -> 0, FontSize -> 11, FontFamily -> "Source Sans Pro"],
Cell[TextData[{"Example 2: fermions, from exterior algebra to Clifford algebra"}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"The Clifford relations ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["x", "2"], "=", SuperscriptBox["y", "2"], "=", "t"}], TraditionalForm]]], ", ", Cell[BoxData[FormBox[RowBox[{"x", "y", "=", "-", "y", "x"}], TraditionalForm]]], " deform ", Cell[BoxData[FormBox[RowBox[{"\[CapitalLambda]", "(", SuperscriptBox["k", "2"], ")"}], TraditionalForm]]], " by the exact family ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["\[Mu]", "t"], "=", SubscriptBox["\[Mu]", "0"], "+", "t", SubscriptBox["\[Mu]", "1"], "+", SuperscriptBox["t", "2"], SubscriptBox["\[Mu]", "2"]}], TraditionalForm]]], ". The term ", Cell[BoxData[FormBox[SubscriptBox["\[Mu]", "1"], TraditionalForm]]], " is a nonzero class in ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "2"], "(", "\[CapitalLambda]", ")"}], TraditionalForm]]], ", and Hochschild cohomology collapses from (2, 4, 6, 8) to (1, 0, 0, 0): the quantized algebra is rigid."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{"Fermionic observables form an exterior algebra; quantization deforms it to the Clifford algebra, whose representation on the quantum Hilbert space is the spinor representation (", ButtonBox["fermionic star products", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://ar5iv.labs.arxiv.org/html/1909.13866"], None}, ButtonNote -> "https://ar5iv.labs.arxiv.org/html/1909.13866"], "). ", ButtonBox["Musson, Pinczon and Ushirobira (2009)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://emis.univie.ac.at/journals/SIGMA/2009/028/sigma09-028.pdf"], None}, ButtonNote -> "https://emis.univie.ac.at/journals/SIGMA/2009/028/sigma09-028.pdf"], " build Clifford-Weyl algebras by the same deformation procedure and compute their HH. Over Q, ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["Cl", RowBox[{"t", "=", "1"}]], "\[TildeFullEqual]", SubscriptBox["M", "2"], "(", "Q", ")"}], TraditionalForm]]], " and ", Cell[BoxData[FormBox[SubscriptBox["Cl", RowBox[{"t", "=", "-1"}]], TraditionalForm]]], " is the quaternion algebra (-1,-1); both are central simple, so ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", RowBox[{"\[GreaterEqual]", "1"}]], "=", "0"}], TraditionalForm]]], "."}], "Text"],
Cell["L = QuantumPlane[-1];                     (* Lambda(k^2) *)\n{mu0, mu1, mu2} = CliffordTerms[];\n{mu0 == Mu[L], CocycleQ[L, mu1], CoboundaryQ[L, mu1]}", "Input"],
Cell["CochainForm[L, mu1]\nCochainForm[L, mu2]", "Input"],
Cell["AssociativeQ[Mu[CliffordFamily[\[FormalT]]]]\nHHDimensions[#, 3] & /@ {L, CliffordFamily[1], CliffordFamily[-1]}", "Input"],
Cell[TextData[{"The second-order term ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["\[Mu]", "2"], "(", "x", "y", ",", "x", "y", ")", "=", "-1"}], TraditionalForm]]], " is forced because ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox[RowBox[{"(", "x", "y", ")"}], "2"], "=", "-", SuperscriptBox["x", "2"], SuperscriptBox["y", "2"], "=", "-", SuperscriptBox["t", "2"]}], TraditionalForm]]], "."}], "Text"],
Cell[TextData[{"Example 3: group algebras and the centraliser decomposition"}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"For ", Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["S", "3"], "]"}], TraditionalForm]]], " the brute-force Hochschild computation agrees with the centraliser formula in degrees 0 to 3 in characteristics 0, 2 and 3."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{"For a finite group G there is an additive decomposition, one summand per conjugacy class [g]:"}], "Text"],
Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "n"], "(", "k", "G", ")", "\[TildeFullEqual]", UnderscriptBox["\[CirclePlus]", RowBox[{"[", "g", "]"}]], SuperscriptBox["H", "n"], "(", SubscriptBox["C", "G"], "(", "g", ")", ",", "k", ")"}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{ButtonBox["Siegel and Witherspoon (1999)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://resolve.cambridge.org/core/journals/proceedings-of-the-london-mathematical-society/article/hochschild-cohomology-ring-of-a-group-algebra/D64020603DF3A33A9C664F1139B4B9CF"], None}, ButtonNote -> "https://resolve.cambridge.org/core/journals/proceedings-of-the-london-mathematical-society/article/hochschild-cohomology-ring-of-a-group-algebra/D64020603DF3A33A9C664F1139B4B9CF"], " computed the cup product in this decomposition and gave presentations for mod-3 ", Cell[BoxData[FormBox[SubscriptBox["S", "3"], TraditionalForm]]], ", mod-2 ", Cell[BoxData[FormBox[SubscriptBox["A", "4"], TraditionalForm]]], " and the mod-2 dihedral 2-groups. ", ButtonBox["Liu and Zhou (2016)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://ems.press/content/serial-article-files/30662?nt=1"], None}, ButtonNote -> "https://ems.press/content/serial-article-files/30662?nt=1"], " realised it at chain level for the bracket and BV operator; ", ButtonBox["Linckelmann's survey", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://icms.ac.uk/wp-content/uploads/2025/07/Markus-Linckelmann.pdf"], None}, ButtonNote -> "https://icms.ac.uk/wp-content/uploads/2025/07/Markus-Linckelmann.pdf"], " covers ", Cell[BoxData[FormBox[SuperscriptBox["HH", "1"], TraditionalForm]]], " of blocks. For ", Cell[BoxData[FormBox[SubscriptBox["S", "3"], TraditionalForm]]], " the classes are e, (12), (123) with centralisers ", Cell[BoxData[FormBox[SubscriptBox["S", "3"], TraditionalForm]]], ", ", Cell[BoxData[FormBox[SubscriptBox["C", "2"], TraditionalForm]]], ", ", Cell[BoxData[FormBox[SubscriptBox["C", "3"], TraditionalForm]]], "; ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["H", "n"], "(", SubscriptBox["S", "3"], ",", SubscriptBox["F", "3"], ")"}], TraditionalForm]]], " is nonzero exactly when ", Cell[BoxData[FormBox[RowBox[{"n", "\[Congruent]", "0", ",", "3", " ", "(", "mod", " ", "4", ")"}], TraditionalForm]]], "."}], "Text"],
Cell["S3 = GroupAlgebra[\"k[S3]\", SymmetricGroup[3]];       (* 6-dimensional *)\nTable[{p, HHDimensions[S3, 3, Modulus -> p],\n  Table[CentralizerPrediction[SymmetricGroup[3], GroupCohomologyDim[p], n], {n, 0, 3}]},\n {p, {0, 2, 3}}] // TableForm", "Input"],
Cell[BoxData[GridBox[{{Cell[TextData[{StyleBox["Characteristic", FontWeight -> "Bold"]}]], Cell[TextData[{Cell[BoxData[FormBox[SuperscriptBox["HH", "0"], TraditionalForm]]]}]], Cell[TextData[{Cell[BoxData[FormBox[SuperscriptBox["HH", "1"], TraditionalForm]]]}]], Cell[TextData[{Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]]}]], Cell[TextData[{Cell[BoxData[FormBox[SuperscriptBox["HH", "3"], TraditionalForm]]]}]], Cell[TextData[{StyleBox["Centraliser prediction", FontWeight -> "Bold"]}]]}, {Cell[TextData[{"0"}]], Cell[TextData[{"3"}]], Cell[TextData[{"0"}]], Cell[TextData[{"0"}]], Cell[TextData[{"0"}]], Cell[TextData[{"(3, 0, 0, 0)"}]]}, {Cell[TextData[{"2"}]], Cell[TextData[{"3"}]], Cell[TextData[{"2"}]], Cell[TextData[{"2"}]], Cell[TextData[{"2"}]], Cell[TextData[{"(3, 2, 2, 2)"}]]}, {Cell[TextData[{"3"}]], Cell[TextData[{"3"}]], Cell[TextData[{"1"}]], Cell[TextData[{"1"}]], Cell[TextData[{"2"}]], Cell[TextData[{"(3, 1, 1, 2)"}]]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxBackground -> {"Rows" -> {RGBColor[0.93, 0.93, 0.93], None}}, GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.6}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}}]], "Text", LineIndent -> 0, FontSize -> 11, FontFamily -> "Source Sans Pro"],
Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "0"], "=", "3"}], TraditionalForm]]], " is the number of conjugacy classes. The jump to 2 in degree 3 at characteristic 3 comes from ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["H", "3"], "(", SubscriptBox["S", "3"], ",", SubscriptBox["F", "3"], ")", "\[NotEqual]", "0"}], TraditionalForm]]], "."}], "Text"],
Cell[TextData[{"Example 4: Morita and derived invariance"}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"The 8-dimensional algebra ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["M", "2"], "(", RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], ")"}], TraditionalForm]]], " has ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "0"], ",", SuperscriptBox["HH", "1"], ",", SuperscriptBox["HH", "2"]}], TraditionalForm]]], " of dimensions (2, 1, 1), exactly those of ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], TraditionalForm]]], "; ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["M", "2"], "(", "k", ")"}], TraditionalForm]]], " matches k with (1, 0, 0)."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "*"], "(", "A", ")", "=", SubsuperscriptBox["Ext", RowBox[{"A", "\[CircleTimes]", SuperscriptBox["A", "op"]}], "*"], "(", "A", ",", "A", ")"}], TraditionalForm]]], " depends only on the module category, so it is Morita invariant. ", ButtonBox["Rickard", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/2509.06369"], None}, ButtonNote -> "https://arxiv.org/pdf/2509.06369"], " proved derived invariance; ", ButtonBox["Keller", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0310221"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0310221"], " showed the bracket is preserved too, reading HH as the Lie algebra of the derived Picard group. ", ButtonBox["Taillefer (2017)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/1706.10044v1"], None}, ButtonNote -> "https://arxiv.org/pdf/1706.10044v1"], " uses ", Cell[BoxData[FormBox[SuperscriptBox["HH", "1"], TraditionalForm]]], " and its Lie structure to separate algebras of dihedral, semi-dihedral and quaternion type up to stable equivalence of Morita type."}], "Text"],
Cell["D1 = DualNumbers[];\nM2D = MatrixRingOver[D1, 2];        (* basis E_ij . {1, x} *)\n{AssociativeQ[Mu[M2D]], HHDimensions[D1, 2], HHDimensions[M2D, 2], HHDimensions[MatrixAlgebra[2], 2]}", "Input"],
Cell[TextData[{"Degree 2 for the 8-dimensional algebra uses a 4096 x 512 coboundary matrix and runs in under 2 seconds; degree 3 would need 32768 x 4096."}], "Text"],
Cell[TextData[{"Example 5: support varieties and complexity"}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"The growth of ", Cell[BoxData[FormBox[RowBox[{"dim", " ", SuperscriptBox["HH", "n"]}], TraditionalForm]]], " reads off the dimension of the support variety. For the Klein four-group in characteristic 2 the dimensions 4, 8, 12, 16, 20 grow linearly: rate 2, the 2-rank of ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["C", "2"], "\[Times]", SubscriptBox["C", "2"]}], TraditionalForm]]], " (Quillen)."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{ButtonBox["Snashall and Solberg", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/0811.4506"], None}, ButtonNote -> "https://arxiv.org/pdf/0811.4506"], " define the support variety of a module M as the max-spectrum of ", Cell[BoxData[FormBox[SuperscriptBox["HH", "ev"], TraditionalForm]]], " modulo nilpotents, cut down by the annihilator of ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["Ext", "*"], "(", "M", ",", "M", ")"}], TraditionalForm]]], ". ", ButtonBox["Erdmann, Holloway, Snashall, Solberg and Taillefer", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0311311"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0311311"], " show that, for self-injective algebras under finite generation (Fg), complexity equals the dimension of the variety. ", ButtonBox["Dotsenko, Gelinas and Tamaroff", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/1909.00487"], None}, ButtonNote -> "https://arxiv.org/pdf/1909.00487"], " show (Fg) holds for a monomial algebra exactly when it is Gorenstein, and ", ButtonBox["Kulshammer, Psaroudakis and Skartsaeterhagen", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/1502.04880v1"], None}, ButtonNote -> "https://arxiv.org/pdf/1502.04880v1"], " show the theory is derived invariant. GrowthRate returns the smallest k whose k-th differences of the dimensions vanish."}], "Text"],
Cell["V4 = KleinFourAlgebra[];\ncases = {{\"k[C2], char 2\", HHDimensions[CyclicGroupAlgebra[2], 5, Modulus -> 2]},\n  {\"k[C2xC2], char 2\", HHDimensions[V4, 4, Modulus -> 2]},\n  {\"k[C2xC2], char 0\", HHDimensions[V4, 3]},\n  {\"Lambda(k^2), char 0\", HHDimensions[QuantumPlane[-1], 4]},\n  {\"k[x]/x^2, char 0\", HHDimensions[DualNumbers[], 5]}};\n{#1, #2, GrowthRate[#2]} & @@@ cases // TableForm", "Input"],
Cell[BoxData[GridBox[{{Cell[TextData[{StyleBox["Algebra", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["dimensions", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["rate", FontWeight -> "Bold"]}]], Cell[TextData[{StyleBox["expected", FontWeight -> "Bold"]}]]}, {Cell[TextData[{Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["C", "2"], "\[Times]", SubscriptBox["C", "2"], "]"}], TraditionalForm]]], ", char 2"}]], Cell[TextData[{"4, 8, 12, 16, 20"}]], Cell[TextData[{"2"}]], Cell[TextData[{"4 classes x ", Cell[BoxData[FormBox[RowBox[{"dim", " ", SuperscriptBox["H", "n"], "(", SubscriptBox["V", "4"], ",", SubscriptBox["F", "2"], ")"}], TraditionalForm]]], " = 4(n+1); Krull dimension 2"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[RowBox[{"\[CapitalLambda]", "(", SuperscriptBox["k", "2"], ")"}], TraditionalForm]]], ", char 0"}]], Cell[TextData[{"2, 4, 6, 8, 10"}]], Cell[TextData[{"2"}]], Cell[TextData[{"Koszul dual k[x, y], Krull dimension 2"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["C", "2"], "]"}], TraditionalForm]]], ", char 2"}]], Cell[TextData[{"2, 2, 2, 2, 2, 2"}]], Cell[TextData[{"1"}]], Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["H", "*"], "(", SubscriptBox["C", "2"], ",", SubscriptBox["F", "2"], ")", "=", SubscriptBox["F", "2"], "[", "u", "]"}], TraditionalForm]]]}]]}, {Cell[TextData[{Cell[BoxData[FormBox[RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], TraditionalForm]]], ", char 0"}]], Cell[TextData[{"2, 1, 1, 1, 1, 1"}]], Cell[TextData[{"1"}]], Cell[TextData[{"periodic resolution"}]]}, {Cell[TextData[{Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["C", "2"], "\[Times]", SubscriptBox["C", "2"], "]"}], TraditionalForm]]], ", char 0"}]], Cell[TextData[{"4, 0, 0, 0"}]], Cell[TextData[{"0"}]], Cell[TextData[{"semisimple"}]]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxBackground -> {"Rows" -> {RGBColor[0.93, 0.93, 0.93], None}}, GridBoxSpacings -> {"Columns" -> {{1}}, "Rows" -> {{0.6}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}}]], "Text", LineIndent -> 0, FontSize -> 11, FontFamily -> "Source Sans Pro"],
Cell[TextData[{"The computed rates are read from finitely many degrees, not proved; each agrees with the known Krull dimension."}], "Text"],
Cell[TextData[{"Example 6: string topology and the BV operator"}], "Section"],
Cell[TextData[{"Result. "}], "Subsubsection"],
Cell[TextData[{"Tradler's operator ", Cell[BoxData[FormBox["\[CapitalDelta]", TraditionalForm]]], " on ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], TraditionalForm]]], ", ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "3"], ")"}], TraditionalForm]]], " and ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", ",", "y", "]", "/", "(", SuperscriptBox["x", "2"], ",", SuperscriptBox["y", "2"], ")"}], TraditionalForm]]], " anticommutes with ", Cell[BoxData[FormBox["\[Delta]", TraditionalForm]]], ", squares to zero on HH, and its failure to be a derivation of ", Cell[BoxData[FormBox["\[Union]", TraditionalForm]]], " is the Gerstenhaber bracket, on every pair of basis classes tested (25, 49 and 169 pairs)."}], "Text"],
Cell[TextData[{"Theory. "}], "Subsubsection"],
Cell[TextData[{"Chas and Sullivan showed that the homology of the free loop space of a manifold is a BV algebra; algebraic models replace the manifold by a symmetric Frobenius algebra. ", ButtonBox["Tradler", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://www.arxiv.org/pdf/math/0210150"], None}, ButtonNote -> "https://www.arxiv.org/pdf/math/0210150"], " defines the BV structure on HH for an algebra with a symmetric, invariant, non-degenerate inner product; ", ButtonBox["Tradler and Zeinalian", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://arxiv.org/pdf/math/0404218"], None}, ButtonNote -> "https://arxiv.org/pdf/math/0404218"], " extend it to Sullivan chord diagrams; ", ButtonBox["Benson, Kessar and Linckelmann (2021)", BaseStyle -> "Hyperlink", ButtonData -> {URL["https://msp.org/pjm/2021/313-1/p01.xhtml"], None}, ButtonNote -> "https://msp.org/pjm/2021/313-1/p01.xhtml"], " compute it for group algebras. With trace ", Cell[BoxData[FormBox["\[CurlyEpsilon]", TraditionalForm]]], " and ", Cell[BoxData[FormBox[RowBox[{"\[LeftAngleBracket]", "a", ",", "b", "\[RightAngleBracket]", "=", "\[CurlyEpsilon]", "(", "a", "b", ")"}], TraditionalForm]]], ":"}], "Text"],
Cell[BoxData[FormBox[RowBox[{"\[LeftAngleBracket]", "\[CapitalDelta]", "f", "(", SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", SubscriptBox["a", RowBox[{"n", "-", "1"}]], ")", ",", SubscriptBox["a", "n"], "\[RightAngleBracket]", "=", UnderoverscriptBox["\[Sum]", RowBox[{"i", "=", "1"}], "n"], SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"i", "(", "n", "-", "1", ")"}]], "\[CurlyEpsilon]", "(", "f", "(", SubscriptBox["a", "i"], ",", "\[Ellipsis]", ",", SubscriptBox["a", "n"], ",", SubscriptBox["a", "1"], ",", "\[Ellipsis]", ",", SubscriptBox["a", RowBox[{"i", "-", "1"}]], ")", ")"}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"Verified in this kit's conventions, for ", Cell[BoxData[FormBox[RowBox[{"f", "\[Element]", SuperscriptBox["HH", "p"]}], TraditionalForm]]], " and ", Cell[BoxData[FormBox[RowBox[{"g", "\[Element]", SuperscriptBox["HH", "q"]}], TraditionalForm]]], ":"}], "Text"],
Cell[BoxData[FormBox[RowBox[{"-", "[", "g", ",", "f", "]", "=", SuperscriptBox[RowBox[{"(", "-1", ")"}], "p"], "\[CapitalDelta]", "(", "f", "\[Union]", "g", ")", "-", SuperscriptBox[RowBox[{"(", "-1", ")"}], "p"], "\[CapitalDelta]", "f", "\[Union]", "g", "-", "f", "\[Union]", "\[CapitalDelta]", "g"}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"Since ", Cell[BoxData[FormBox[RowBox[{"-", "[", "g", ",", "f", "]", "=", SuperscriptBox[RowBox[{"(", "-1", ")"}], RowBox[{"(", "p", "-", "1", ")", "(", "q", "-", "1", ")"}]], "[", "f", ",", "g", "]"}], TraditionalForm]]], ", the kit's bracket and the Benson-Kessar-Linckelmann bracket differ by that sign, the convention difference Tradler mentions. Read literally with the kit's bracket, their formula fails on ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", ",", "y", "]", "/", "(", SuperscriptBox["x", "2"], ",", SuperscriptBox["y", "2"], ")"}], TraditionalForm]]], " in degree pairs (0,2) and (2,2); the swapped form passes everywhere."}], "Text"],
Cell["BVIdentityQ[DualNumbers[], {0, 1}, 3]                  (* eps(x) = 1 *)\nBVIdentityQ[TruncatedPolynomial[3], {0, 0, 1}, 2]      (* eps(x^2) = 1 *)\nBVIdentityQ[QuantumPlane[1], {0, 0, 0, 1}, 2]          (* eps(xy) = 1 *)", "Input"],
Cell["Run all six examples", "Section"],
Cell["RunAllApplications[] // Dataset", "Input"],
Cell["Sources", "Section"],
Cell[TextData[{"The literature claims come from the abstracts and excerpts these sources show in search results; the papers were not read in full."}], "Text"],
