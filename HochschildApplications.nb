(* Content-type: application/vnd.wolfram.mathematica *)
Notebook[{
Cell["Applications of Hochschild Cohomology", "Title"],
Cell["Six worked examples with HochschildKit and HochschildApplications", "Subtitle"],
Cell[TextData[{Cell[BoxData[FormBox["\[Copyright]", TraditionalForm]]], " Computational Classnotes ", Cell[BoxData[FormBox["\[CenterDot]", TraditionalForm]]], " CC BY-NC-SA 4.0"}], "Text"],
Cell[BoxData[RowBox[{"DateString", "[", "]"}]], "Input", Evaluatable -> False, Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell[BoxData["\"Wed 18 Nov 2026 01:28:50\""], "Output", Editable -> False, Deletable -> False, CellLabel -> "Created:"],
Cell["Keep this notebook in the same folder as HochschildKit.wl and HochschildApplications.wl.", "Text"],
Cell["SetDirectory[NotebookDirectory[]];\nGet[\"HochschildKit.wl\"];\nGet[\"HochschildApplications.wl\"];", "Input"],
Cell[TextData[{"1. Deformation quantization: Poisson brackets from ", Cell[BoxData[FormBox[SuperscriptBox["HH", "2"], TraditionalForm]]]}], "Section"],
Cell[TextData[{"For a commutative algebra, the antisymmetric part of a first-order deformation is a Poisson bracket (Kontsevich 1997; HKR in degree 2). For ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", ",", "y", "]", "/", "(", SuperscriptBox["x", "2"], ",", SuperscriptBox["y", "2"], ")"}], TraditionalForm]]], " exactly one of the five classes has one, ", Cell[BoxData[FormBox[RowBox[{"{", "x", ",", "y", "}", "=", RowBox[{"x", "y"}], "/", "2"}], TraditionalForm]]], ", and the quantum plane quantizes it."}], "Text"],
Cell["A = QuantumPlane[1];\nPoissonFromDeformation[A] // Dataset", "Input"],
Cell["w = AntisymmetricPart[HHBasis[A, 2][[4]]];\n{PoissonQ[A, w], CochainForm[A, w]}", "Input"],
Cell[TextData[{"2. Fermions: exterior algebra ", Cell[BoxData[FormBox["\[LongRightArrow]", TraditionalForm]]], " Clifford algebra"}], "Section"],
Cell[TextData[{"The relations ", Cell[BoxData[FormBox[RowBox[{SuperscriptBox["x", "2"], "=", SuperscriptBox["y", "2"], "=", "t"}], TraditionalForm]]], ", ", Cell[BoxData[FormBox[RowBox[{"x", "y", "=", "-", "y", "x"}], TraditionalForm]]], " give an exact deformation ", Cell[BoxData[FormBox[RowBox[{SubscriptBox["\[Mu]", "0"], "+", "t", SubscriptBox["\[Mu]", "1"], "+", SuperscriptBox["t", "2"], SubscriptBox["\[Mu]", "2"]}], TraditionalForm]]], " of ", Cell[BoxData[FormBox[RowBox[{"\[CapitalLambda]", "(", SuperscriptBox["k", "2"], ")"}], TraditionalForm]]], ". Its Hochschild cohomology collapses from (2, 4, 6, 8) to (1, 0, 0, 0)."}], "Text"],
Cell["L = QuantumPlane[-1];\n{mu0, mu1, mu2} = CliffordTerms[];\n{mu0 == Mu[L], CocycleQ[L, mu1], CoboundaryQ[L, mu1]}\nCochainForm[L, mu1]\nCochainForm[L, mu2]\nAssociativeQ[Mu[CliffordFamily[\[FormalT]]]]\nHHDimensions[#, 3] & /@ {L, CliffordFamily[1], CliffordFamily[-1]}", "Input"],
Cell["3. Group algebras: the centraliser decomposition", "Section"],
Cell[TextData[{"The centraliser decomposition (Siegel-Witherspoon), one summand per conjugacy class [g]:"}], "Text"],
Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "n"], "(", "k", "G", ")", "\[TildeFullEqual]", UnderscriptBox["\[CirclePlus]", RowBox[{"[", "g", "]"}]], SuperscriptBox["H", "n"], "(", SubscriptBox["C", "G"], "(", "g", ")", ",", "k", ")"}], TraditionalForm]], "DisplayFormula"],
Cell[TextData[{"For ", Cell[BoxData[FormBox[SubscriptBox["S", "3"], TraditionalForm]]], " the evaluator gives (3, 0, 0, 0), (3, 2, 2, 2) and (3, 1, 1, 2) in characteristics 0, 2 and 3. Degree 3 takes a few seconds."}], "Text"],
Cell["S3 = GroupAlgebra[\"k[S3]\", SymmetricGroup[3]];\nTable[{p, HHDimensions[S3, 3, Modulus -> p],\n  Table[CentralizerPrediction[SymmetricGroup[3], GroupCohomologyDim[p], n], {n, 0, 3}]}, {p, {0, 2, 3}}] // TableForm", "Input"],
Cell["4. Morita and derived invariance", "Section"],
Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SuperscriptBox["HH", "*"], "(", SubscriptBox["M", "2"], "(", "A", ")", ")", "=", SuperscriptBox["HH", "*"], "(", "A", ")"}], TraditionalForm]]], ", checked for ", Cell[BoxData[FormBox[RowBox[{"A", "=", "k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], TraditionalForm]]], "."}], "Text"],
Cell["D1 = DualNumbers[];\nM2D = MatrixRingOver[D1, 2];\n{AssociativeQ[Mu[M2D]], HHDimensions[D1, 2], HHDimensions[M2D, 2], HHDimensions[MatrixAlgebra[2], 2]}", "Input"],
Cell["5. Support varieties and complexity", "Section"],
Cell[TextData[{"The growth rate of ", Cell[BoxData[FormBox[RowBox[{"dim", " ", SuperscriptBox["HH", "n"]}], TraditionalForm]]], " matches the Krull dimension: 2 for ", Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["C", "2"], "\[Times]", SubscriptBox["C", "2"], "]"}], TraditionalForm]]], " in characteristic 2 and for ", Cell[BoxData[FormBox[RowBox[{"\[CapitalLambda]", "(", SuperscriptBox["k", "2"], ")"}], TraditionalForm]]], "; 1 for ", Cell[BoxData[FormBox[RowBox[{"k", "[", SubscriptBox["C", "2"], "]"}], TraditionalForm]]], " in characteristic 2 and for ", Cell[BoxData[FormBox[RowBox[{"k", "[", "x", "]", "/", "(", SuperscriptBox["x", "2"], ")"}], TraditionalForm]]], "; 0 for semisimple algebras."}], "Text"],
Cell["cases = {{\"k[C2], char 2\", HHDimensions[CyclicGroupAlgebra[2], 5, Modulus -> 2]},\n  {\"k[C2xC2], char 2\", HHDimensions[KleinFourAlgebra[], 4, Modulus -> 2]},\n  {\"k[C2xC2], char 0\", HHDimensions[KleinFourAlgebra[], 3]},\n  {\"Lambda(k^2), char 0\", HHDimensions[QuantumPlane[-1], 4]},\n  {\"k[x]/x^2, char 0\", HHDimensions[DualNumbers[], 5]}};\n{#1, #2, GrowthRate[#2]} & @@@ cases // TableForm", "Input"],
Cell["6. String topology: the BV operator", "Section"],
Cell[TextData[{"Tradler's operator ", Cell[BoxData[FormBox["\[CapitalDelta]", TraditionalForm]]], " on a symmetric Frobenius algebra satisfies, in this kit's conventions, on HH:"}], "Text"],
Cell[BoxData[FormBox[RowBox[{"-", "[", "g", ",", "f", "]", "=", SuperscriptBox[RowBox[{"(", "-1", ")"}], "p"], "\[CapitalDelta]", "(", "f", "\[Union]", "g", ")", "-", SuperscriptBox[RowBox[{"(", "-1", ")"}], "p"], "\[CapitalDelta]", "f", "\[Union]", "g", "-", "f", "\[Union]", "\[CapitalDelta]", "g"}], TraditionalForm]], "DisplayFormula"],
Cell["BVIdentityQ[DualNumbers[], {0, 1}, 3]\nBVIdentityQ[TruncatedPolynomial[3], {0, 0, 1}, 2]\nBVIdentityQ[QuantumPlane[1], {0, 0, 0, 1}, 2]", "Input"],
Cell["Run everything", "Section"],
Cell["RunAllApplications[] // Dataset", "Input"],
Cell[TextData[{Cell[BoxData[FormBox["\[Copyright]", TraditionalForm]]], " Computational Classnotes ", Cell[BoxData[FormBox["\[CenterDot]", TraditionalForm]]], " CC BY-NC-SA 4.0"}], "Text"]
}, WindowSize -> {1000, 800}, StyleDefinitions -> "Default.nb"]
